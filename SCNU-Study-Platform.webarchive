     detectType / matchTopics / topTerms
   ========================================================= */
(function (global) {
  'use strict';

/* ---------------------------------------------------------
   4. AI 模块 · 知识库
   --------------------------------------------------------- */
const TOPICS = [
  {
    name: '极限与连续', course: '高等数学（上）',
    kw: ['极限', 'lim', '趋近', '无穷小', '无穷大', '洛必达', '夹逼', '连续', '间断点'],
    points: ['未定式（0/0、∞/∞）可用洛必达法则，但必须先验证条件', '等价无穷小替换只能在乘除中直接使用，加减需谨慎', '夹逼准则适合放缩后两端极限相同的场景', '连续性三要素：有定义、极限存在、极限值等于函数值'],
    pitfalls: ['加减法里拆开用等价无穷小是常见错误', '洛必达法则连续使用前每次都要重新验证是否为未定式']
  },
  {
    name: '导数与微分', course: '高等数学（上）',
    kw: ['求导', '导数', '微分', '切线', '法线', '极值', '单调', '凹凸', '拐点', '罗尔', '拉格朗日', '柯西中值'],
    points: ['隐函数求导时把 y 看作 x 的函数，逐项对 x 求导', '参数方程求导用 dy/dx = (dy/dt)/(dx/dt)', '极值判定：一阶导变号 或 二阶导正负', '中值定理题大多需要构造辅助函数 F(x)'],
    pitfalls: ['忘记对 y 再乘一个 y′', '把驻点直接等同于极值点'],
    steps: ['先判断函数类型（显函数 / 隐函数 / 参数方程 / 分段函数）', '分段点处必须用左右导数定义判断可导性', '求出导数后回到原题所问（切线、单调区间还是极值）']
  },
  {
    name: '积分', course: '高等数学（上）',
    kw: ['积分', '原函数', '不定积分', '定积分', '换元', '分部积分', '面积', '旋转体', '广义积分'],
    points: ['换元积分要同步换掉积分上下限', '分部积分口诀：反对幂指三，前者为 u', '有理函数先做部分分式分解再积分', '定积分几何应用要判断上下曲线关系'],
    pitfalls: ['换元后忘记换积分限', '偶函数在对称区间积分的性质用反了'],
    steps: ['先看能否直接套基本积分表', '不行再依次尝试：凑微分 → 换元 → 分部积分 → 部分分式']
  },
  {
    name: '级数', course: '高等数学（下）',
    kw: ['级数', '收敛', '发散', '幂级数', '泰勒', '麦克劳林', '傅里叶', '收敛半径'],
    points: ['正项级数首选比值判别法', '交错级数用莱布尼茨判别法', '幂级数逐项求导与逐项积分不改变收敛半径', '泰勒展开需注意收敛区间与余项'],
    pitfalls: ['把必要条件（通项趋于 0）当成充分条件', '收敛半径端点要单独讨论']
  },
  {
    name: '线性代数 · 矩阵与行列式', course: '线性代数',
    kw: ['矩阵', '行列式', '逆矩阵', '秩', '初等变换', '可逆', '伴随', '分块'],
    points: ['求逆矩阵常用增广矩阵 (A|E) 行变换法', '矩阵乘法不满足交换律，AB ≠ BA', '秩的三条常用不等式是化简证明题的钥匙', '解线性方程组：先化阶梯形，再看秩与未知数个数'],
    pitfalls: ['|kA| = kⁿ|A|，漏掉 n 次方', '(AB)⁻¹ = B⁻¹A⁻¹，顺序别写反'],
    steps: ['先把已知条件写成矩阵等式', '化为行阶梯形，标出主元位置', '根据秩的关系判断解的三种情形']
  },
  {
    name: '线性代数 · 特征值与二次型', course: '线性代数',
    kw: ['特征值', '特征向量', '相似', '对角化', '正交', '二次型', '正定', '实对称'],
    points: ['特征值之和等于迹，之积等于行列式（可用于验算）', 'n 阶矩阵可对角化的充要条件是每个特征值的几何重数等于代数重数', '实对称矩阵必可正交对角化', '二次型正定 ⟺ 所有顺序主子式大于 0'],
    pitfalls: ['特征向量是非零向量，零向量不能算', '相似变换用的是 P⁻¹AP，不是 PAP⁻¹']
  },
  {
    name: '概率论与数理统计', course: '概率论与数理统计',
    kw: ['概率', '期望', '方差', '分布', '正态', '泊松', '二项', '贝叶斯', '条件概率', '独立', '中心极限', '假设检验', '极大似然'],
    points: ['条件概率 P(A|B) = P(AB)/P(B)，注意分母不为 0', '全概率公式用于“分情况”，贝叶斯用于“已知结果反推原因”', '独立 ⇒ 不相关，反之一般不成立', 'E(aX+bY) = aE(X)+bE(Y) 无需独立性，方差则需要'],
    pitfalls: ['把互斥当成独立', '算方差时忘记先减均值'],
    steps: ['先明确随机变量与它的分布类型', '列出目标事件，用全概率/贝叶斯法拆解', '最后代入公式计算并检验结果是否落在合法区间']
  },
  {
    name: '数据结构 · 线性表', course: '数据结构',
    kw: ['顺序表', '链表', '单链表', '双向链表', '栈', '队列', '循环队列', '数组', '头结点'],
    points: ['顺序表随机访问 O(1)，插入删除平均 O(n)', '链表插入删除 O(1)，但访问需要 O(n)', '循环队列判满常用 (rear+1)%max == front 留一个空位', '带头结点可统一插入删除的首元素处理'],
    pitfalls: ['链表断链：先接后继再改前驱', '空栈 / 空队列的边界条件写错'],
    steps: ['明确存储结构是顺序还是链式', '画出操作前后的指针图', '逐条写出指针修改顺序，注意临时变量保命']
  },
  {
    name: '数据结构 · 树与二叉树', course: '数据结构',
    kw: ['二叉树', '遍历', '前序', '中序', '后序', '层序', '哈夫曼', '平衡树', 'avl', '完全二叉树', '线索'],
    points: ['前序 + 中序 或 后序 + 中序 才能唯一确定一棵二叉树', '由遍历序列还原：先序第一个（后序最后一个）是根，在中序中分左右子树', '完全二叉树可用数组顺序存储，结点 i 的孩子是 2i 和 2i+1', '哈夫曼树带权路径长度最短，可用于编码'],
    pitfalls: ['只有前序和后序无法唯一还原', '层序遍历必须借助队列，不能递归'],
    steps: ['从序列中确定根结点', '在中序序列中定位根，切分左右子树区间', '对左右子树递归重复，最后按要求的顺序拼出结果']
  },
  {
    name: '数据结构 · 图', course: '数据结构',
    kw: ['图', '最短路', '迪杰斯特拉', 'dijkstra', '弗洛伊德', 'floyd', '最小生成树', '普里姆', '克鲁斯卡尔', '拓扑排序', 'dfs', 'bfs', '深度优先', '广度优先', '并查集', '关键路径'],
    points: ['DFS 用栈（或递归），BFS 用队列', 'Dijkstra 不能处理负权边，负权要用 Bellman-Ford', 'Prim 适合稠密图，Kruskal 适合稀疏图', '拓扑排序存在 ⟺ 有向图无环'],
    pitfalls: ['无向图邻接矩阵是对称的，统计边数别除以 2 时算错', 'Dijkstra 每次选择的是未确定集合中距离最小的点'],
    steps: ['先把图用邻接矩阵或邻接表表示出来', '根据题目特征选择算法并写出数据结构', '逐步模拟算法过程，每一步记录更新了哪些值']
  },
  {
    name: '排序与查找', course: '数据结构',
    kw: ['排序', '冒泡', '插入排序', '选择排序', '快速排序', '归并排序', '堆排序', '希尔', '基数', '二分查找', '折半'],
    points: ['快排平均 O(n log n)，最坏 O(n²)，不稳定', '归并排序稳定，稳定 O(n log n)，但需 O(n) 额外空间', '堆排序原地、不稳定，建堆 O(n)', '二分查找要求序列有序，查找长度按判定树计算'],
    pitfalls: ['稳定性记混：快排、选择、堆排都不稳定', '二分查找 mid 计算与边界收缩写错导致死循环'],
    steps: ['写出一趟排序后的序列', '统计比较次数与移动次数', '需要判断稳定性时逐个查看相等元素是否交换位置']
  },
  {
    name: '算法复杂度分析', course: '算法设计与分析',
    kw: ['时间复杂度', '空间复杂度', '复杂度', '主定理', '大o', '渐进', '均摊', '递归式', 'o(n'],
    points: ['只保留最高阶项，忽略常数系数', '递归式 T(n) = aT(n/b) + f(n) 可用主定理', '常见量级排序：O(1) < O(log n) < O(n) < O(n log n) < O(n²) < O(2ⁿ)', '均摊分析和平均分析不是一回事'],
    pitfalls: ['把循环里常数层的操作算成 O(n)', '忘记递归调用栈带来的空间开销'],
    steps: ['写出基本操作的执行次数表达式', '对求和式做化简，取最高阶项', '同时给出最好 / 最坏 / 平均情况，若题目只问一个就答最坏']
  },
  {
    name: '算法设计思想', course: '算法设计与分析',
    kw: ['动态规划', 'dp', '背包', '最长公共子序列', '状态转移', '贪心', '分治', '回溯', '剪枝', '分支限界', '备忘录'],
    points: ['动态规划三要素：状态定义、状态转移方程、边界条件', '最优子结构 + 重叠子问题 才适合 DP', '贪心要求每一步的局部最优能推出全局最优，需要证明', '回溯 = DFS + 剪枝，注意恢复现场'],
