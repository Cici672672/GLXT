</body></html>Ytext/htmlP_*https://scnu-study-hub.app.workbuddy.host/UUTF-8�"�_WebResourceResponseO␀�/* =========================================================
   学业互助 · 华师答疑资源共享平台
   v2.0 · 账号版
   ---------------------------------------------------------
   账号体系与云端存档由 cloud.js 承担；AI 能力来自 ai.js。
   本文件只负责界面、交互与数据模型的组装。
   ========================================================= */

const { solveProblem = () => null, extractKnowledge = () => null, summarizeText = () => null } =
  window.StudyAI || {};

/* ---------------------------------------------------------
   1. 课程数据
   --------------------------------------------------------- */
const COURSES = [
  { id: 'calc1', name: '高等数学（上）', dept: '数学科学学院' },
  { id: 'calc2', name: '高等数学（下）', dept: '数学科学学院' },
  { id: 'la', name: '线性代数', dept: '数学科学学院' },
  { id: 'prob', name: '概率论与数理统计', dept: '数学科学学院' },
  { id: 'dm', name: '离散数学', dept: '计算机学院' },
  { id: 'c', name: '程序设计基础（C语言）', dept: '计算机学院' },
  { id: 'ds', name: '数据结构', dept: '计算机学院' },
  { id: 'algo', name: '算法设计与分析', dept: '计算机学院' },
  { id: 'co', name: '计算机组成原理', dept: '计算机学院' },
  { id: 'os', name: '操作系统', dept: '计算机学院' },
  { id: 'net', name: '计算机网络', dept: '计算机学院' },
  { id: 'db', name: '数据库系统原理', dept: '计算机学院' },
  { id: 'aii', name: '人工智能导论', dept: '人工智能学院' },
  { id: 'ml', name: '机器学习', dept: '人工智能学院' },
  { id: 'en', name: '大学英语', dept: '公共必修' },
  { id: 'phy', name: '大学物理', dept: '公共必修' }
];

const COURSE_NAME = {};
COURSES.forEach((c) => { COURSE_NAME[c.id] = c.name; });

const RESOURCE_TYPES = [
  { name: '课件', icon: '📊' },
  { name: '笔记', icon: '📒' },
  { name: '真题', icon: '📄' },
  { name: '代码', icon: '💻' },
  { name: '参考书', icon: '📖' }
];

function typeIcon(t) {
  const hit = RESOURCE_TYPES.find((x) => x.name === t);
  return hit ? hit.icon : '📁';
}

/* ---------------------------------------------------------
   2. 云端数据模型
   ---------------------------------------------------------
   云端数据行 -> 内存模型。字段名与数据库解耦，渲染层只认这套结构。
   每次写入后重新拉取，保证不同同学看到的是同一份内容。
   --------------------------------------------------------- */
const db = {
  questions: [],
  resources: [],
  voted: [],          // 当前账号点赞过的回答 id
  profile: { nickname: '华师同学' },
  userId: null,
  hasProfile: false,
  loaded: false
};

function mapQuestion(row) {
  return {
    id: String(row.id),
    ownerId: row.owner_id,
    title: row.title,
    body: row.body,
    course: row.course,
    tags: row.tags || [],
    author: row.author,
    views: row.views || 0,
    createdAt: new Date(row.created_at).getTime(),
    solved: !!row.accepted_answer_id,
    acceptedAnswerId: row.accepted_answer_id == null ? null : String(row.accepted_answer_id),
    answers: []
  };
}

function mapAnswer(row) {
  return {
    id: String(row.id),
    ownerId: row.owner_id,
    questionId: String(row.question_id),
    author: row.author,
    body: row.body,
    votes: row.votes || 0,
    createdAt: new Date(row.created_at).getTime()
  };
}

function mapResource(row) {
  return {
    id: String(row.id),
    ownerId: row.owner_id,
    title: row.title,
    course: row.course,
    type: row.type,
    desc: row.description || '上传者未填写简介。',
    author: row.author,
    createdAt: new Date(row.created_at).getTime(),
    size: Number(row.file_size) || 0,
    downloads: row.downloads || 0,
    rating: Number(row.rating) || 0,
    ratingCount: row.rating_count || 0,
    filePath: row.file_path || null,
    fileName: row.file_name || null
  };
}

function applyRaw(raw) {
  const byId = {};
  raw.questions.forEach((row) => { byId[String(row.id)] = mapQuestion(row); });

  raw.answers.forEach((row) => {
    const q = byId[String(row.question_id)];
    if (q) q.answers.push(mapAnswer(row));
  });

  Object.keys(byId).forEach((key) => {
    const q = byId[key];
    q.answers.sort((x, y) => {
      const bx = x.id === q.acceptedAnswerId;
      const by = y.id === q.acceptedAnswerId;
      if (bx !== by) return bx ? -1 : 1;
      return y.votes - x.votes || x.createdAt - y.createdAt;
    });
  });

  db.questions = Object.keys(byId).map((k) => byId[k]).sort((a, b) => b.createdAt - a.createdAt);
  db.resources = raw.resources.map(mapResource);
  db.voted = raw.votes.map((v) => String(v.answer_id));
  db.hasProfile = !!(raw.profiles && raw.profiles.length);
  db.profile.nickname = db.hasProfile
    ? (raw.profiles[0].nickname || defaultNickname())
    : defaultNickname();
}

/** 从云端重新拉取全部业务数据 */
async function refresh() {
  const raw = await CloudData.fetchAll(db.userId);
  applyRaw(raw);
  db.loaded = true;
}

/* 只读访问器：写入一律走 CloudData，不再有任何本地落盘 */
const Store = {
  signedIn() { return !!db.userId; },
  userId() { return db.userId; },
  nickname() { return db.profile.nickname || '华师同学'; },
  questions() { return db.questions.slice(); },
  question(id) { return db.questions.find((q) => q.id === String(id)) || null; },
  resources() { return db.resources.slice(); },
  resource(id) { return db.resources.find((r) => r.id === String(id)) || null; },
  hasVoted(id) { return db.voted.indexOf(String(id)) >= 0; },
  /** 是否为当前账号创建的内容——仅用于决定按钮显隐，安全边界在数据库 */
  isMine(row) { return !!db.userId && !!row && row.ownerId === db.userId; }
};

/* ---------------------------------------------------------
   3. 工具函数
   --------------------------------------------------------- */
const $ = (sel, root = document) => root.querySelector(sel);
const $$ = (sel, root = document) => Array.from(root.querySelectorAll(sel));

function esc(s) {
  return String(s == null ? '' : s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

function fmtDate(ts) {
  const d = new Date(ts);
  const p = (n) => String(n).padStart(2, '0');
  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`;
}

function fmtAgo(ts) {
  const diff = Date.now() - ts;
  const m = Math.floor(diff / 60000);
  if (m < 1) return '刚刚';
  if (m < 60) return m + ' 分钟前';
  const h = Math.floor(m / 60);
  if (h < 24) return h + ' 小时前';
  const d = Math.floor(h / 24);
  if (d < 30) return d + ' 天前';
  return fmtDate(ts).slice(0, 10);
}

function fmtSize(bytes) {
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(0) + ' KB';
  return (bytes / 1024 / 1024).toFixed(1) + ' MB';
}

function stars(n) {
  const full = Math.round(n);
  return '★'.repeat(Math.max(0, Math.min(5, full))) + '☆'.repeat(Math.max(0, 5 - full));
}

let toastTimer = null;
function toast(msg) {
  const el = $('#toast');
  el.textContent = msg;
  el.hidden = false;
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => { el.hidden = true; }, 2400);
}


/* ---------------------------------------------------------
   4. 账号体系（登录 / 注册 / 找回密码 / 退出）
   --------------------------------------------------------- */
const authState = {
  session: null,
  method: 'email',        // email | phone
  emailMode: 'login',     // login | signup | reset
  pendingEmail: null,     // { email, verificationId, isExistingUser }
  pendingPhone: null,
  resetHandle: null,
  countdown: null
};

const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
const PHONE_RE = /^1\d{10}$/;

function sessionUser() {
  return (authState.session && authState.session.user) || null;
}

/** 默认昵称：优先取邮箱前缀，其次取手机号后四位 */
function defaultNickname() {
  const u = sessionUser();
  if (!u) return '华师同学';
  if (u.email) {
    const name = String(u.email).split('@')[0];
    return (name || '华师同学').slice(0, 12);
  }
  if (u.phone) return '同学' + String(u.phone).slice(-4);
  return '华师同学';
}

/** 账号标识脱敏展示，避免在界面上明文暴露联系方式 */
function maskedAccount() {
  const u = sessionUser();
  if (!u) return '';
  if (u.email) {
    const parts = String(u.email).split('@');
    return parts[0].slice(0, 1) + '***@' + (parts[1] || '');
  }
  if (u.phone) return String(u.phone).replace(/(\d{3})\d{4}(\d{4})/, '$1****$2');
  return '微信账号';
}

function authHint() {
  return '登录后你发布的提问、回答与资料会存档在账号下，换设备登录同样能看到。';
}

function renderAuthArea() {
  const box = $('#authArea');
  if (!box) return;

  if (!CloudAuth.enabled) {
    box.innerHTML = '<span class="auth-off">云端未连接</span>';
    return;
  }
  if (!Store.signedIn()) {
    box.innerHTML = '<button class="btn btn-soft btn-sm" id="navLogin">登录 / 注册</button>';
    return;
  }
  const nick = Store.nickname();
  box.innerHTML = `
    <button class="auth-chip" id="navUser" title="进入我的空间">
      <span class="auth-avatar">${esc(nick.slice(0, 1))}</span>
      <span class="auth-name">${esc(nick)}</span>
    </button>
    <button class="btn btn-text btn-sm" id="navLogout">退出</button>`;
}

/* ---------------- 登录弹窗 ---------------- */

function openAuthModal(hint) {
  if (!CloudAuth.enabled) { toast(CloudAuth.initError || '云端服务未就绪'); return; }

  authState.method = 'email';
  authState.emailMode = 'login';
  authState.pendingEmail = null;
  authState.pendingPhone = null;
  authState.resetHandle = null;

  openModal(`
    <h2>登录 / 注册</h2>
    <p class="modal-sub">${esc(hint || authHint())}</p>
    <div class="auth-tabs" id="authTabs">
      <button type="button" class="auth-tab is-active" data-method="email">邮箱</button>
      <button type="button" class="auth-tab" data-method="phone">手机号</button>
    </div>
    <div id="authBody"></div>
    <div class="auth-divider"><span>或</span></div>
    <button type="button" class="btn btn-soft btn-block" id="authWechat">微信扫码 / 一键登录</button>
    <p class="tip">微信授权登录需要已发布的正式域名，本地预览环境无法完成回调授权。</p>`);

  renderAuthBody();
}

function renderAuthBody() {
  const box = $('#authBody');
  if (!box) return;
  $$('#authTabs .auth-tab').forEach((b) => {
    b.classList.toggle('is-active', b.dataset.method === authState.method);
  });
  box.innerHTML = authState.method === 'email' ? emailFormHtml() : phoneFormHtml();
}

function emailFormHtml() {
  if (authState.emailMode === 'login') {
    return `
      <form class="form" id="emailForm">
        <label class="field">
          <span class="label">邮箱</span>
          <input type="email" id="authEmail" autocomplete="email" placeholder="you@m.scnu.edu.cn" />
        </label>
        <label class="field">
          <span class="label">密码</span>
          <input type="password" id="authPassword" autocomplete="current-password" placeholder="请输入密码" />
        </label>
        <div class="form-error" id="authError" hidden></div>
        <div class="modal-actions">
          <button type="submit" class="btn btn-primary btn-sm">登录</button>
          <button type="button" class="btn btn-text btn-sm" data-auth="toSignup">注册新账号</button>
        </div>
        <p class="auth-links">
          <button type="button" class="link-btn" data-auth="toCode">用邮箱验证码登录</button>
          <span class="sep">·</span>
          <button type="button" class="link-btn" data-auth="toReset">忘记密码</button>
        </p>
      </form>`;
  }

  const mode = authState.emailMode;
  const needPassword = mode !== 'code';
  const codeLabel = mode === 'reset' ? '重置密码验证码' : '邮箱验证码';
  const pwdLabel = mode === 'reset' ? '设置新密码' : '设置密码';
  const submitText = mode === 'reset' ? '重置密码并登录' : (mode === 'signup' ? '注册并登录' : '登录');

  return `
    <form class="form" id="emailForm">
      <label class="field">
        <span class="label">邮箱</span>
        <input type="email" id="authEmail" autocomplete="email" placeholder="you@m.scnu.edu.cn" />
      </label>
      <div class="field-row">
        <label class="field">
          <span class="label">${codeLabel}</span>
          <input type="text" id="authCode" inputmode="numeric" maxlength="6" autocomplete="one-time-code" placeholder="6 位数字" />
        </label>
        <label class="field field-btn">
          <span class="label">&nbsp;</span>
          <button type="button" class="btn btn-soft btn-sm btn-block" data-auth="sendEmailCode">获取验证码</button>
        </label>
      </div>
      ${needPassword ? `
      <label class="field">
        <span class="label">${pwdLabel}</span>
        <input type="password" id="authPassword" autocomplete="new-password" placeholder="至少 6 位" />
      </label>` : ''}
      <div class="form-error" id="authError" hidden></div>
      <div class="modal-actions">
        <button type="submit" class="btn btn-primary btn-sm">${submitText}</button>
        <button type="button" class="btn btn-text btn-sm" data-auth="toLogin">返回登录</button>
      </div>
    </form>`;
}

function phoneFormHtml() {
  return `
    <form class="form" id="phoneForm">
      <label class="field">
        <span class="label">手机号</span>
        <input type="tel" id="authPhone" inputmode="numeric" maxlength="11" autocomplete="tel" placeholder="11 位手机号" />
        <span class="field-error" id="phoneError" hidden></span>
      </label>
      <div class="field-row">
        <label class="field">
          <span class="label">短信验证码</span>
          <input type="text" id="authPhoneCode" inputmode="numeric" maxlength="6" autocomplete="one-time-code" placeholder="6 位数字" />
        </label>
        <label class="field field-btn">
          <span class="label">&nbsp;</span>
          <button type="button" class="btn btn-soft btn-sm btn-block" data-auth="sendPhoneCode">获取验证码</button>
        </label>
      </div>
      <div class="form-error" id="authError" hidden></div>
      <div class="modal-actions">
        <button type="submit" class="btn btn-primary btn-sm">登录 / 注册</button>
      </div>
    </form>`;
}

function setFormError(msg) {
  const el = $('#authError');
  if (!el) return;
  el.textContent = msg || '';
  el.hidden = !msg;
}

function setFieldError(id, msg) {
  const el = $('#' + id);
  if (!el) return;
  el.textContent = msg || '';
  el.hidden = !msg;
}

function startCountdown(btn) {
  if (!btn) return;
  stopCountdown();
  let left = 60;
  const original = btn.textContent;
  btn.disabled = true;
  btn.textContent = left + ' 秒后可重发';
  authState.countdown = setInterval(() => {
    left -= 1;
    if (left <= 0) {
      stopCountdown();
      btn.disabled = false;
      btn.textContent = original;
      return;
    }
    btn.textContent = left + ' 秒后可重发';
  }, 1000);
}

function stopCountdown() {
  if (authState.countdown) {
    clearInterval(authState.countdown);
    authState.countdown = null;
  }
}

/* ---------------- 验证码发送 ---------------- */

async function sendEmailCode(btn) {
  const email = ($('#authEmail') && $('#authEmail').value.trim()) || '';
  setFormError('');
  if (!EMAIL_RE.test(email)) { setFormError('请输入正确的邮箱地址。'); return; }

  setBusy(btn, true, '发送中…');

  if (authState.emailMode === 'reset') {
    const res = await CloudAuth.startPasswordReset(email);
    setBusy(btn, false);
    if (!res.ok) { setFormError(res.message); return; }
    authState.resetHandle = res.handle;
  } else {
    const res = await CloudAuth.sendOtp({ email });
    setBusy(btn, false);
    if (!res.ok) { setFormError(res.message); return; }
    authState.pendingEmail = {
      email,
      verificationId: res.verificationId,
      isExistingUser: res.isExistingUser
    };
  }

  startCountdown(btn);
  toast('验证码已发送，请查收邮箱（也看一下垃圾邮件）');
}

async function sendPhoneCode(btn) {
  const phone = ($('#authPhone') && $('#authPhone').value.trim()) || '';
  setFieldError('phoneError', '');
  setFormError('');
  if (!PHONE_RE.test(phone)) { setFieldError('phoneError', '请输入正确的 11 位手机号'); return; }

  setBusy(btn, true, '发送中…');
  const res = await CloudAuth.sendOtp({ phone });
  setBusy(btn, false);
  if (!res.ok) { setFormError(res.message); return; }

  authState.pendingPhone = {
    phone,
    verificationId: res.verificationId,
    isExistingUser: res.isExistingUser
  };
  startCountdown(btn);
  toast('验证码已发送，请查看短信');
}

/* ---------------- 表单提交 ---------------- */

/** 密码登录失败：基础设施类错误照原样提示，其余一律归为凭据不正确，避免把服务端英文文案抛给用户 */
const TRANSIENT_KINDS = ['network', 'backend-unavailable', 'rate_limit', 'too_many_requests', 'server_error'];

function authFailureText(res) {
  if (TRANSIENT_KINDS.indexOf(res.kind) >= 0) return res.message;
  return '邮箱或密码不正确，请重试。';
}

async function submitEmailForm(e, btn) {
  e.preventDefault();
  setFormError('');

  const mode = authState.emailMode;
  const email = ($('#authEmail') && $('#authEmail').value.trim()) || '';
  const password = ($('#authPassword') && $('#authPassword').value) || '';
  const code = ($('#authCode') && $('#authCode').value.trim()) || '';

  if (!EMAIL_RE.test(email)) { setFormError('请输入正确的邮箱地址。'); return; }

  /* ① 邮箱 + 密码登录 */
  if (mode === 'login') {
    if (!password) { setFormError('请输入密码。'); return; }
    setBusy(btn, true, '登录中…');
    const res = await CloudAuth.signInWithPassword(email, password);
    setBusy(btn, false);
    if (!res.ok) { setFormError(authFailureText(res)); return; }
    await finishSignIn(res.session);
    return;
  }

  const pending = authState.pendingEmail;

  if (mode === 'reset') {
    if (!code) { setFormError('请输入重置密码验证码。'); return; }
    if (password.length < 6) { setFormError('新密码至少 6 位。'); return; }
    if (!authState.resetHandle) { setFormError('请先获取重置密码验证码。'); return; }

    setBusy(btn, true, '提交中…');
    const res = await CloudAuth.finishPasswordReset(authState.resetHandle, code, password);
    setBusy(btn, false);
    if (!res.ok) { setFormError(res.message); return; }
    await finishSignIn(res.session);
    return;
  }

  if (!pending || pending.email !== email) { setFormError('请先获取当前邮箱的验证码。'); return; }
  if (!code) { setFormError('请输入邮箱验证码。'); return; }

  /* ② 邮箱验证码登录（已有账号，无需密码） */
  if (mode === 'code') {
    setBusy(btn, true, '登录中…');
    const res = await CloudAuth.verifyOtp({
      email: pending.email,
      verificationId: pending.verificationId,
      isExistingUser: pending.isExistingUser,
      token: code
    });
    setBusy(btn, false);
    if (!res.ok) {
      setFormError(pending.isExistingUser
        ? res.message
        : '这个邮箱还没有注册过，请改用「注册新账号」设置密码后完成注册。');
      return;
    }
    authState.pendingEmail = null;
    await finishSignIn(res.session);
    return;
  }

  /* ③ 注册：新账号必须设置密码；已存在的账号只做验证码登录 */
  if (!pending.isExistingUser && password.length < 6) {
    setFormError('请设置至少 6 位密码。');
    return;
  }

  setBusy(btn, true, '提交中…');
  const res = await CloudAuth.verifyOtp({
    email: pending.email,
    verificationId: pending.verificationId,
    isExistingUser: pending.isExistingUser,
    token: code,
    password: pending.isExistingUser ? undefined : password
  });
  setBusy(btn, false);
  if (!res.ok) { setFormError(res.message); return; }

  authState.pendingEmail = null;
  await finishSignIn(res.session);
}

async function submitPhoneForm(e, btn) {
  e.preventDefault();
  setFormError('');
  setFieldError('phoneError', '');

  const phone = ($('#authPhone') && $('#authPhone').value.trim()) || '';
  const code = ($('#authPhoneCode') && $('#authPhoneCode').value.trim()) || '';

  if (!PHONE_RE.test(phone)) { setFieldError('phoneError', '请输入正确的 11 位手机号'); return; }

  const pending = authState.pendingPhone;
  if (!pending || pending.phone !== phone) { setFormError('请先获取当前手机号的验证码。'); return; }
  if (!code) { setFormError('请输入短信验证码。'); return; }

  setBusy(btn, true, '登录中…');
  const res = await CloudAuth.verifyOtp({
    phone: pending.phone,
    verificationId: pending.verificationId,
    isExistingUser: pending.isExistingUser,
    token: code
  });
  setBusy(btn, false);
  if (!res.ok) { setFormError(res.message); return; }

  authState.pendingPhone = null;
  await finishSignIn(res.session);
}

/* ---------------- 会话流转 ---------------- */

/** 登录成功后的统一收尾：建立资料行、拉取云端数据、刷新界面 */
async function finishSignIn(session, options) {
  const silent = !!(options && options.silent);

  authState.session = session || null;
  db.userId = (session && session.user && session.user.id) || null;

  stopCountdown();
  if (!silent) closeModal();
  renderAuthArea();

  try {
    await refresh();
    if (db.userId && !db.hasProfile) {
      await CloudData.saveNickname(db.userId, defaultNickname());
      await refresh();
    }
  } catch (err) {
    showCloudNotice('账号数据加载失败：' + err.message);
  }

  renderAuthArea();
  applyRoute();
  if (!silent) toast('已登录：' + Store.nickname());
}

async function doSignOut() {
  if (!Store.signedIn()) { openAuthModal(); return; }
  if (!window.confirm('退出登录后需要重新登录才能发帖和上传资料，确定退出吗？')) return;

  const res = await CloudAuth.signOut();
  if (!res.ok) { toast(res.message); return; }

  authState.session = null;
  db.userId = null;
  db.voted = [];
  db.hasProfile = false;
  db.profile.nickname = '华师同学';

  renderAuthArea();
  try { await refresh(); } catch (e) { /* 退出后拉取失败不阻塞 */ }
  applyRoute();
  toast('已退出登录');
}

async function startWechatLogin() {
  const res = await CloudAuth.startWechatLogin();
  if (!res.ok) { toast(res.message); return; }
  // signInWithOAuth 只返回地址，导航由应用自己负责
  location.assign(res.url);
}

/**
 * 登录守卫：未登录时弹出登录框。
 * @returns {boolean} 是否已登录
 */
function requireLogin(actionText) {
  if (!CloudAuth.enabled) {
    toast(CloudAuth.initError || '云端服务未就绪，暂时无法发布内容。');
    return false;
  }
  if (Store.signedIn()) return true;
  openAuthModal(actionText ? '登录后即可' + actionText + '，内容会存档在你的账号里。' : '');
  return false;
}

/** 登录弹窗内部的按钮动作分发 */
function handleAuthAction(action, btn) {
  if (action === 'sendEmailCode') { sendEmailCode(btn); return; }
  if (action === 'sendPhoneCode') { sendPhoneCode(btn); return; }
  if (action === 'toSignup') { authState.emailMode = 'signup'; renderAuthBody(); return; }
  if (action === 'toCode') { authState.emailMode = 'code'; renderAuthBody(); return; }
  if (action === 'toReset') { authState.emailMode = 'reset'; renderAuthBody(); return; }
  if (action === 'toLogin') { authState.emailMode = 'login'; renderAuthBody(); }
}

/* ---------------------------------------------------------
   5. 界面辅助
   --------------------------------------------------------- */
function setBusy(btn, busy, busyText) {
  if (!btn) return;
  if (busy) {
    if (btn.dataset.originalText === undefined) btn.dataset.originalText = btn.textContent;
    btn.disabled = true;
    if (busyText) btn.textContent = busyText;
  } else {
    btn.disabled = false;
    if (btn.dataset.originalText !== undefined) {
      btn.textContent = btn.dataset.originalText;
      delete btn.dataset.originalText;
    }
  }
}

function showCloudNotice(msg) {
  const el = $('#cloudNotice');
  if (!el || !msg) return;
  el.textContent = msg;
  el.hidden = false;
}

/* ---------------------------------------------------------
   6. 路由
   --------------------------------------------------------- */
const PAGES = ['home', 'qa', 'q', 'resources', 'ai', 'mine', 'about'];
const NAV_OF = { q: 'qa' };

function parseHash() {
  const raw = location.hash.replace(/^#\/?/, '');
  const parts = raw.split('/').filter(Boolean);
  const route = PAGES.includes(parts[0]) ? parts[0] : 'home';
  return { route, param: parts[1] || '' };
}

function navigate(path) {
  location.hash = '#/' + path;
}

function applyRoute() {
  const { route, param } = parseHash();

  PAGES.forEach((p) => {
    const el = $('#page-' + p);
    if (el) el.hidden = p !== route;
  });

  const navKey = NAV_OF[route] || route;
  $$('#nav a').forEach((a) => a.classList.toggle('is-active', a.dataset.route === navKey));

  if (route === 'home') { renderStats(); renderHeroFeed(); renderCourseGrid(); renderHomeLists(); }
  if (route === 'qa') renderQa();
  if (route === 'q') renderQuestionDetail(param);
  if (route === 'resources') renderResources();
  if (route === 'mine') renderMine();

  window.scrollTo(0, 0);
}

/* ---------------------------------------------------------
   7. 首页渲染
   --------------------------------------------------------- */
function renderStats() {
  const qs = Store.questions();
  const rs = Store.resources();
  const answers = qs.reduce((n, q) => n + (q.answers ? q.answers.length : 0), 0);
  $('#statQ').textContent = qs.length;
  $('#statSolved').textContent = qs.filter((q) => q.solved).length;
  $('#statA').textContent = answers;
  $('#statR').textContent = rs.length;
}

function renderHeroFeed() {
  const list = Store.questions()
    .slice()
    .filter((q) => !q.solved)
    .sort((a, b) => b.createdAt - a.createdAt)
    .slice(0, 5);

  const box = $('#heroFeed');
  if (list.length === 0) {
    box.innerHTML = '<li><span class="dot"></span><span class="t">暂时没有问题，等你来问第一个</span><span class="c"></span></li>';
    return;
  }
  box.innerHTML = list.map((q) => `
    <li data-jump="${q.id}">
      <span class="dot"></span>
      <span class="t">${esc(q.title)}</span>
      <span class="c">${esc(COURSE_NAME[q.course] || '')}</span>
    </li>`).join('');
}

function renderCourseGrid() {
  const qs = Store.questions();
  const rs = Store.resources();
  const grid = $('#courseGrid');

  const counts = {};
  qs.forEach((q) => { counts[q.course] = counts[q.course] || { q: 0, r: 0 }; counts[q.course].q++; });
  rs.forEach((r) => { counts[r.course] = counts[r.course] || { q: 0, r: 0 }; counts[r.course].r++; });

  const list = COURSES.slice().sort((a, b) => {
    const ca = counts[a.id] || { q: 0, r: 0 };
    const cb = counts[b.id] || { q: 0, r: 0 };
    return (cb.q + cb.r) - (ca.q + ca.r);
  }).slice(0, 8);

  grid.innerHTML = list.map((c) => {
    const ct = counts[c.id] || { q: 0, r: 0 };
    return `
      <button class="course-card" data-course="${c.id}">
        <span class="cdept">${esc(c.dept)}</span>
        <span class="cname">${esc(c.name)}</span>
        <span class="cmeta">${ct.q} 个问题 · ${ct.r} 份资料</span>
      </button>`;
  }).join('');
}

function questionItem(q, showExcerpt = true) {
  const answerCount = q.answers ? q.answers.length : 0;
  return `
    <article class="q-item" data-qid="${q.id}">
      <div class="q-stats">
        <div><div class="num">${answerCount}</div><div class="lbl">回答</div></div>
        <div><div class="num">${q.views || 0}</div><div class="lbl">浏览</div></div>
      </div>
      <div class="q-body">
        <h3>${esc(q.title)}</h3>
        ${showExcerpt ? `<p class="q-excerpt">${esc((q.body || '').slice(0, 90))}${(q.body || '').length > 90 ? '…' : ''}</p>` : ''}
        <div class="q-meta">
          <span class="tag course">${esc(COURSE_NAME[q.course] || '未分类')}</span>
          <span class="tag ${q.solved ? 'solved' : 'open'}">${q.solved ? '已解决' : '待解答'}</span>
          ${(q.tags || []).slice(0, 3).map((t) => `<span class="tag">${esc(t)}</span>`).join('')}
          <span>${esc(q.author)}</span>
          <span>${fmtAgo(q.createdAt)}</span>
        </div>
      </div>
    </article>`;
}

function renderHomeLists() {
  const qs = Store.questions().slice().sort((a, b) => b.createdAt - a.createdAt).slice(0, 5);
  $('#homeQuestions').innerHTML = qs.map((q) => questionItem(q)).join('') ||
    '<div class="empty"><p>还没有问题</p></div>';

  const rs = Store.resources().slice().sort((a, b) => b.downloads - a.downloads).slice(0, 5);
  $('#homeResources').innerHTML = rs.map((r) => `
    <div class="r-mini" data-rid="${r.id}">
      <div class="ricon">${typeIcon(r.type)}</div>
      <div class="rtxt">
        <div class="rtitle">${esc(r.title)}</div>
        <div class="rsub">${esc(COURSE_NAME[r.course] || '未分类')} · ${esc(r.type)} · ${r.downloads} 次下载</div>
      </div>
    </div>`).join('') || '<div class="empty"><p>还没有资料</p></div>';
}

/* ---------------------------------------------------------
   8. 答疑区
   --------------------------------------------------------- */
let qaState = { course: 'all', status: 'all', keyword: '', sort: 'new' };

function renderCourseFilter() {
  const qs = Store.questions();
  const counts = {};
  qs.forEach((q) => { counts[q.course] = (counts[q.course] || 0) + 1; });

  const box = $('#courseFilter');
  let html = `<button class="filter-item ${qaState.course === 'all' ? 'is-active' : ''}" data-course="all">全部课程 <i>${qs.length}</i></button>`;
  COURSES.forEach((c) => {
    const n = counts[c.id] || 0;
    if (n === 0 && qaState.course !== c.id) return;
    html += `<button class="filter-item ${qaState.course === c.id ? 'is-active' : ''}" data-course="${c.id}">${esc(c.name)} <i>${n}</i></button>`;
  });
  box.innerHTML = html;

  const openN = qs.filter((q) => !q.solved).length;
  const solvedN = qs.filter((q) => q.solved).length;
  const sf = $('#statusFilter');
  sf.querySelector('[data-status="all"] i').textContent = qs.length;
  sf.querySelector('[data-status="open"] i').textContent = openN;
  sf.querySelector('[data-status="solved"] i').textContent = solvedN;
}

function filteredQuestions() {
  let list = Store.questions();

  if (qaState.course !== 'all') list = list.filter((q) => q.course === qaState.course);
  if (qaState.status === 'open') list = list.filter((q) => !q.solved);
  if (qaState.status === 'solved') list = list.filter((q) => q.solved);

  if (qaState.keyword) {
    const k = qaState.keyword.toLowerCase();
    list = list.filter((q) =>
      (q.title || '').toLowerCase().includes(k) ||
      (q.body || '').toLowerCase().includes(k) ||
      (COURSE_NAME[q.course] || '').toLowerCase().includes(k) ||
      (q.tags || []).some((t) => t.toLowerCase().includes(k))
    );
  }

  if (qaState.sort === 'new') list.sort((a, b) => b.createdAt - a.createdAt);
  if (qaState.sort === 'answers') list.sort((a, b) => (b.answers || []).length - (a.answers || []).length);
  if (qaState.sort === 'views') list.sort((a, b) => (b.views || 0) - (a.views || 0));

  return list;
}

function renderQa() {
  renderCourseFilter();
  const list = filteredQuestions();
  $('#qaList').innerHTML = list.map((q) => questionItem(q)).join('');
  $('#qaEmpty').hidden = list.length > 0;

  const scope = qaState.course === 'all' ? '全部课程' : COURSE_NAME[qaState.course];
  $('#qaCount').textContent = `${scope} · 共 ${list.length} 个问题`;
  $('#qaSearch').value = qaState.keyword;
  $('#qaSort').value = qaState.sort;
}

/* ---------------------------------------------------------
   9. 问题详情
   --------------------------------------------------------- */
function renderQuestionDetail(id) {
  const q = Store.question(id);
  const box = $('#qDetail');
  if (!q) {
    box.innerHTML = '<div class="empty"><p>这个问题不存在或已被删除。</p></div>';
    return;
  }

  // 浏览量 +1：同一标签页内同一个问题只计一次，累加由数据库函数在服务端完成
  if (!sessionStorage_viewed('viewed_' + q.id)) {
    q.views = (q.views || 0) + 1;
    CloudData.bumpQuestionView(q.id).catch(() => {});
  }

  const canAccept = Store.isMine(q);
  const answers = (q.answers || []).map((a) => ({ ...a, accepted: a.id === q.acceptedAnswerId }));

  box.innerHTML = `
    <div class="qd-head">
      <h1>${esc(q.title)}</h1>
      <div class="qd-meta">
        <span class="tag course">${esc(COURSE_NAME[q.course] || '未分类')}</span>
        <span class="tag ${q.solved ? 'solved' : 'open'}">${q.solved ? '已解决' : '待解答'}</span>
        ${(q.tags || []).map((t) => `<span class="tag">${esc(t)}</span>`).join('')}
        <span>${esc(q.author)}</span>
        <span>发布于 ${fmtDate(q.createdAt)}</span>
        <span>${q.views || 0} 次浏览</span>
      </div>
    </div>

    <div class="qd-body">${esc(q.body)}</div>

    <div class="modal-actions" style="margin-top:16px">
      <button class="btn btn-soft btn-sm" id="qdAi">🤖 用 AI 辅助解析</button>
      ${Store.isMine(q) ? '<button class="btn btn-text btn-sm" id="qdDel">删除这个问题</button>' : ''}
    </div>

    <div class="answer-block">
      <h3>${answers.length} 条回答</h3>
      <div id="answerList">
        ${answers.length ? answers.map((a) => answerCard(a, canAccept)).join('') : '<div class="empty" style="padding:28px 0"><p>还没有人回答，你可以做第一个。</p></div>'}
      </div>

      ${answerFormHtml()}
    </div>`;
}

/** 回答输入区：未登录时替换为登录引导 */
function answerFormHtml() {
  if (Store.signedIn()) {
    return `
      <div class="answer-form">
        <label class="label">写下你的回答</label>
        <textarea id="answerText" rows="5" placeholder="分享你的思路，讲清楚为什么这样做，比只给答案更有帮助。"></textarea>
        <div class="row">
          <button class="btn btn-primary btn-sm" id="answerSubmit">发布回答</button>
          <span class="small">回答会存档在你的账号下</span>
        </div>
      </div>`;
  }
  return `
    <div class="answer-form locked">
      <p>登录后即可写下你的回答，内容会存档在账号里，换设备也能找到。</p>
      <button class="btn btn-primary btn-sm" data-open="login">登录 / 注册</button>
    </div>`;
}

const viewedSet = new Set();
function sessionStorage_viewed(key) {
  if (viewedSet.has(key)) return true;
  viewedSet.add(key);
  return false;
}

function answerCard(a, canAccept) {
  const voted = Store.hasVoted(a.id);
  const mine = Store.isMine(a);
  return `
    <div class="answer ${a.accepted ? 'accepted' : ''}" data-aid="${a.id}">
      <div class="answer-head">
        <span class="who">${esc(a.author)}</span>
        ${mine ? '<span class="tag mine">我的回答</span>' : ''}
        ${a.accepted ? '<span class="tag solved">已被采纳</span>' : ''}
        <span>${fmtDate(a.createdAt)}</span>
      </div>
      <div class="answer-body">${esc(a.body)}</div>
      <div class="answer-foot">
        <button class="icon-btn ${voted ? 'on' : ''}" data-act="vote">▲ 有帮助 ${a.votes}</button>
        ${canAccept ? `<button class="icon-btn ${a.accepted ? 'on' : ''}" data-act="accept">✓ 采纳此回答</button>` : ''}
        ${mine ? '<button class="icon-btn del" data-act="del">删除</button>' : ''}
      </div>
    </div>`;
}

/* ---------------------------------------------------------
  10. 资料库
   --------------------------------------------------------- */
let rState = { type: 'all', course: 'all', keyword: '' };

function renderResourceCourseOptions() {
  const sel = $('#rCourse');
  const cur = rState.course;
  sel.innerHTML = '<option value="all">全部课程</option>' +
    COURSES.map((c) => `<option value="${c.id}">${esc(c.name)}</option>`).join('');
  sel.value = cur;
}

function resourceCard(r) {
  const rated = r.ratingCount > 0;
  return `
    <article class="resource-card" data-rid="${r.id}">
      <div class="rc-head">
        <div class="rc-icon">${typeIcon(r.type)}</div>
        <div>
          <h3>${esc(r.title)}</h3>
          <div class="q-meta" style="margin-top:6px">
            <span class="tag course">${esc(COURSE_NAME[r.course] || '未分类')}</span>
            <span class="tag">${esc(r.type)}</span>
            ${r.filePath ? '' : '<span class="tag ghost">示例条目 · 无文件</span>'}
          </div>
        </div>
      </div>
      <p class="rc-desc">${esc(r.desc)}</p>
      <div class="rc-foot">
        <span class="stars">${rated ? stars(r.rating) + ' ' + r.rating.toFixed(1) : '暂无评分'}</span>
        <span>${r.downloads} 次下载 · ${r.size > 0 ? fmtSize(r.size) : '大小未知'}</span>
      </div>
      <div class="rc-foot">
        <span>上传者 ${esc(r.author)} · ${fmtAgo(r.createdAt)}</span>
        <button class="icon-btn" data-act="download" ${r.filePath ? '' : 'disabled'}>${r.filePath ? '下载' : '暂无文件'}</button>
      </div>
    </article>`;
}

function renderResources() {
  renderResourceCourseOptions();
  let list = Store.resources();

  if (rState.type !== 'all') list = list.filter((r) => r.type === rState.type);
  if (rState.course !== 'all') list = list.filter((r) => r.course === rState.course);
  if (rState.keyword) {
    const k = rState.keyword.toLowerCase();
    list = list.filter((r) =>
      (r.title || '').toLowerCase().includes(k) ||
      (r.desc || '').toLowerCase().includes(k) ||
      (COURSE_NAME[r.course] || '').toLowerCase().includes(k)
    );
  }
  list.sort((a, b) => b.downloads - a.downloads);

  $('#resourceGrid').innerHTML = list.map(resourceCard).join('');
  $('#rEmpty').hidden = list.length > 0;
  $('#rCount').textContent = `课件、笔记、真题、代码，按课程归档 · 共 ${list.length} 份`;
  $('#rSearch').value = rState.keyword;
}

/* ---------------------------------------------------------
  11. 我的
   --------------------------------------------------------- */
let mineState = 'questions';

function renderMine() {
  const box = $('#mineBody');
  const nickInput = $('#nickname');

  if (!Store.signedIn()) {
    nickInput.value = '';
    nickInput.disabled = true;
    nickInput.placeholder = '登录后设置昵称';
    $('#avatar').textContent = '?';
    $('#accountLine').textContent = '尚未登录';
    $('#mineQCount').textContent = '0';
    $('#mineACount').textContent = '0';
    $('#mineRCount').textContent = '0';
    box.innerHTML = `
      <div class="empty">
        <p>登录后这里会显示你发过的提问、回答与上传的资料。</p>
        <button class="btn btn-primary btn-sm" data-open="login">登录 / 注册</button>
      </div>`;
    return;
  }

  const nick = Store.nickname();
  nickInput.disabled = false;
  nickInput.placeholder = '设置一个昵称';
  nickInput.value = nick;
  $('#avatar').textContent = nick.slice(0, 1);
  $('#accountLine').textContent = '已登录 · ' + maskedAccount();

  const qs = Store.questions();
  const myQ = qs.filter((q) => Store.isMine(q));
  const myA = [];
  qs.forEach((q) => (q.answers || []).forEach((a) => {
    if (Store.isMine(a)) myA.push({ q, a: Object.assign({}, a, { accepted: a.id === q.acceptedAnswerId }) });
  }));
  const myR = Store.resources().filter((r) => Store.isMine(r));

  $('#mineQCount').textContent = myQ.length;
  $('#mineACount').textContent = myA.length;
  $('#mineRCount').textContent = myR.length;

  if (mineState === 'questions') {
    box.innerHTML = myQ.length
      ? `<div class="q-list">${myQ.sort((a, b) => b.createdAt - a.createdAt).map((q) => questionItem(q)).join('')}</div>`
      : '<div class="empty"><p>你还没有提过问题</p><button class="btn btn-primary btn-sm" data-open="ask">去提问</button></div>';
  } else if (mineState === 'answers') {
    box.innerHTML = myA.length
      ? myA.sort((x, y) => y.a.createdAt - x.a.createdAt).map(({ q, a }) => `
          <div class="card" style="margin-bottom:14px">
            <p class="small">回答于问题：</p>
            <h3 style="font-size:15.5px;margin:6px 0 10px">
              <a href="#/q/${q.id}">${esc(q.title)}</a>
            </h3>
            <div class="answer-body">${esc(a.body)}</div>
            <div class="q-meta" style="margin-top:10px">
              ${a.accepted ? '<span class="tag solved">已被采纳</span>' : ''}
              <span>${a.votes} 个赞</span>
              <span>${fmtDate(a.createdAt)}</span>
            </div>
          </div>`).join('')
      : '<div class="empty"><p>你还没有回答过问题</p><button class="btn btn-primary btn-sm" data-open="qa">去答疑区看看</button></div>';
  } else {
    box.innerHTML = myR.length
      ? `<div class="resource-grid">${myR.map(resourceCard).join('')}</div>`
      : '<div class="empty"><p>你还没有上传过资料</p><button class="btn btn-primary btn-sm" data-open="upload">上传资料</button></div>';
  }
}

/* ---------------------------------------------------------
  12. 弹窗：提问 / 上传 / AI 解析
   --------------------------------------------------------- */
function openModal(html, wide) {
  const box = $('#modal').querySelector('.modal-box');
  box.classList.toggle('wide', !!wide);
  $('#modalBody').innerHTML = html;
  $('#modal').hidden = false;
}
function closeModal() {
  stopCountdown();
  $('#modal').hidden = true;
}

function courseOptions(selected) {
  return COURSES.map((c) =>
    `<option value="${c.id}" ${selected === c.id ? 'selected' : ''}>${esc(c.name)}</option>`).join('');
}

function openAskModal(prefillCourse) {
  openModal(`
    <h2>发起提问</h2>
    <p class="modal-sub">选对课程，同专业的同学更容易看到你的问题。发布后会存档在你的账号下。</p>
    <form class="form" id="askForm">
      <label class="field">
        <span class="label">问题标题 <i>*</i></span>
        <input type="text" id="askTitle" maxlength="70" placeholder="一句话说清楚卡在哪里，例如：Dijkstra 算法为什么不能处理负权边？" required />
      </label>
      <div class="field-row">
        <label class="field">
          <span class="label">所属课程 <i>*</i></span>
          <select id="askCourse">${courseOptions(prefillCourse || 'ds')}</select>
        </label>
        <label class="field">
          <span class="label">标签（逗号分隔）</span>
          <input type="text" id="askTags" placeholder="例如：算法, 图论" />
        </label>
      </div>
      <label class="field">
        <span class="label">问题描述 <i>*</i></span>
        <textarea id="askBody" rows="7" placeholder="把题目、你的尝试、以及具体卡住的步骤写出来，别人更容易帮到你。"></textarea>
      </label>
      <div class="modal-actions">
        <button type="submit" class="btn btn-primary btn-sm">发布问题</button>
        <button type="button" class="btn btn-soft btn-sm" id="askAi">🤖 先让 AI 给个思路</button>
        <button type="button" class="btn btn-text btn-sm" data-close>取消</button>
      </div>
    </form>`);
}

function openUploadModal() {
  const maxMB = Math.round(CloudData.UPLOAD.maxBytes / 1024 / 1024);
  const accept = CloudData.UPLOAD.exts.map((x) => '.' + x).join(',');

  openModal(`
    <h2>上传学习资料</h2>
    <p class="modal-sub">文件会上传到云端存储，登录的同学都能查看和下载。单个文件不超过 ${maxMB} MB。</p>
    <form class="form" id="uploadForm">
      <label class="field">
        <span class="label">资料名称 <i>*</i></span>
        <input type="text" id="upTitle" maxlength="60" placeholder="例如：数据结构期末复习提纲（第 1-8 章）" required />
      </label>
      <div class="field-row">
        <label class="field">
          <span class="label">所属课程 <i>*</i></span>
          <select id="upCourse">${courseOptions('ds')}</select>
        </label>
        <label class="field">
          <span class="label">资料类型 <i>*</i></span>
          <select id="upType">${RESOURCE_TYPES.map((t) => `<option value="${t.name}">${t.icon} ${t.name}</option>`).join('')}</select>
        </label>
      </div>
      <label class="field">
        <span class="label">选择文件 <i>*</i></span>
        <input type="file" id="upFile" accept="${accept}" />
        <span class="small" id="upFileInfo">未选择文件</span>
      </label>
      <label class="field">
        <span class="label">资料简介</span>
        <textarea id="upDesc" rows="3" placeholder="这份资料的适用范围、是否含答案、重点章节等。"></textarea>
      </label>
      <div class="modal-actions">
        <button type="submit" class="btn btn-primary btn-sm">确认上传</button>
        <button type="button" class="btn btn-text btn-sm" data-close>取消</button>
      </div>
    </form>`);

  $('#upFile').addEventListener('change', (e) => {
    const f = e.target.files && e.target.files[0];
    const info = $('#upFileInfo');
    if (!f) {
      info.textContent = '未选择文件';
      info.classList.remove('warn-text');
      return;
    }
    const bad = CloudData.validateFile(f);
    info.textContent = bad || ('已选择：' + f.name + '（' + fmtSize(f.size) + '）');
    info.classList.toggle('warn-text', !!bad);
    if (!bad && !$('#upTitle').value.trim()) {
      $('#upTitle').value = f.name.replace(/\.[^.]+$/, '').slice(0, 60);
    }
  });
}

/** AI 解析弹窗（问题详情中使用） */
function openAiSolveModal(text, titleText) {
  const res = solveProblem(text);
  if (!res) { toast('没有可解析的内容'); return; }

  openModal(`
    <h2>AI 题目辅助解析</h2>
    <p class="modal-sub">${esc(titleText || '基于你提供的题目内容')}</p>
    <div id="aiSolveBody">${solveHtml(res)}</div>
    <p class="tip">AI 提供的是思路框架，不代替完整解答，请结合教材自行验证。</p>`, true);
}

/* ---------------------------------------------------------
  13. AI 结果 HTML
   --------------------------------------------------------- */
function solveHtml(res) {
  const topicTags = res.topics.length
    ? res.topics.map((t) => `<span class="tag course">${esc(t.topic.name)}</span>`).join('')
    : '<span class="tag">未识别到明确知识点</span>';

  const courseTags = res.relatedCourses.length
    ? res.relatedCourses.map((c) => `<span class="tag">${esc(c)}</span>`).join('')
    : '';

  return `
    <div class="ai-sec">
      <h4>题型判定</h4>
      <p class="lead-line">${res.qtype.icon} <b>${esc(res.qtype.name)}</b>
        ${res.qtypeMatched ? `<span class="small">（命中 ${res.qtypeMatched} 个题型特征词）</span>` : '<span class="small">（未命中特征词，按通用流程处理）</span>'}
      </p>
    </div>

    <div class="ai-sec">
      <h4>涉及知识点</h4>
      <div class="badge-row">${topicTags}</div>
      ${courseTags ? `<p class="small" style="margin-top:8px">关联课程：${res.relatedCourses.join('、')}</p>` : ''}
    </div>

    <div class="ai-sec">
      <h4>建议解题步骤</h4>
      <ol class="step-list">${res.steps.map((s) => `<li>${esc(s)}</li>`).join('')}</ol>
    </div>

    ${res.knowledge.length ? `
    <div class="ai-sec">
      <h4>关键提示</h4>
      <ul class="bullet-list">${res.knowledge.slice(0, 8).map((k) => `<li>${esc(k.text)}<span class="small"> · 来自「${esc(k.from)}」</span></li>`).join('')}</ul>
    </div>` : ''}

    ${res.pitfalls.length ? `
    <div class="ai-sec">
      <h4>易错点提醒</h4>
      <ul class="bullet-list warn">${res.pitfalls.slice(0, 6).map((p) => `<li>${esc(p)}</li>`).join('')}</ul>
    </div>` : ''}

    ${res.extraTips.length ? `
    <div class="ai-sec">
      <h4>读题提示</h4>
      <ul class="bullet-list">${res.extraTips.map((t) => `<li>${esc(t)}</li>`).join('')}</ul>
    </div>` : ''}
  `;
}

function extractHtml(res) {
  return `
    <div class="ai-sec">
      <h4>概览</h4>
      <p class="lead-line">共切分出 <b>${res.sentenceCount}</b> 个句子，提炼出 <b>${res.knowledgeCount}</b> 条知识点。</p>
    </div>
    <div class="ai-sec">
      <h4>知识点清单</h4>
      <div class="kp-list">
        ${res.knowledge.map((k) => `
          <div class="kp ${k.type}">
            <span class="kp-tag">${esc(k.label)}</span>
            <span>${esc(k.text)}</span>
          </div>`).join('')}
      </div>
    </div>
    <div class="ai-sec">
      <h4>高频术语</h4>
      <div class="badge-row">
        ${res.terms.map((t) => `<span class="tag">${esc(t.word)} <span class="small">×${t.count}</span></span>`).join('')}
      </div>
    </div>`;
}

function summaryHtml(res) {
  if (res.tooShort) {
    return `
      <div class="ai-sec">
        <h4>内容较短</h4>
        <p class="lead-line">只有 ${res.sentenceCount} 个句子，无需压缩，直接给出关键词。</p>
      </div>
      <div class="ai-sec">
        <h4>关键词</h4>
        <div class="badge-row">${res.keywords.map((t) => `<span class="tag">${esc(t.word)}</span>`).join('')}</div>
      </div>`;
  }

  return `
    <div class="ai-sec">
      <h4>全文摘要</h4>
      <p class="lead-line">${esc(res.summary)}</p>
    </div>
    <div class="ai-sec">
      <h4>关键要点</h4>
      <ul class="bullet-list">${res.points.map((p) => `<li>${esc(p)}</li>`).join('')}</ul>
    </div>
    <div class="ai-sec">
      <h4>关键词</h4>
      <div class="badge-row">${res.keywords.map((t) => `<span class="tag">${esc(t.word)} <span class="small">×${t.count}</span></span>`).join('')}</div>
    </div>
    <div class="ai-sec">
      <h4>压缩情况</h4>
      <p class="small">原文 ${res.charCount} 字 → 摘要 ${res.summaryChars} 字，压缩率 ${(res.compression * 100).toFixed(0)}%（保留 ${res.pickedCount}/${res.sentenceCount} 句）</p>
    </div>`;
}

/* ---------------------------------------------------------
  14. AI 页面交互
   --------------------------------------------------------- */
let aiTool = 'solve';

const AI_PLACEHOLDER = {
  solve: ['把题目粘进来', '例如：设二叉树的中序遍历为 DBEAFC，前序遍历为 ABDECF，求后序遍历。'],
  extract: ['把讲义或笔记粘进来', '例如一段课程讲义原文，AI 会挑出定义、分类、性质和方法类句子。'],
  summary: ['把要总结的长资料粘进来', '例如一整章复习提纲，AI 会压缩成摘要与关键要点。']
};

const AI_SAMPLE = {
  solve: '设二叉树的中序遍历序列为 DBEAFC，前序遍历序列为 ABDECF，请写出该二叉树的后序遍历序列，并说明还原过程。',
  extract: '数据结构中的树是一种非线性结构，它是由 n 个结点的有限集合组成。' +
    '二叉树是每个结点至多有两棵子树的树结构，子树有左右之分，次序不能颠倒。' +
    '二叉树的性质包括：第 i 层至多有 2 的 i-1 次方个结点；深度为 k 的二叉树至多有 2 的 k 次方减一个结点。' +
    '二叉树的遍历方法分为前序遍历、中序遍历、后序遍历和层序遍历四种，其中层序遍历需要借助队列实现。' +
    '完全二叉树是指除最后一层外每一层都达到最大结点数，且最后一层的结点集中在左边的二叉树。' +
    '因此，完全二叉树适合用顺序存储结构表示，结点 i 的左右孩子分别是 2i 和 2i+1。',
  summary: '本章主要讨论二叉树的存储结构与遍历算法。二叉树的顺序存储适合完全二叉树，链式存储使用左右孩子指针，适用面更广。' +
    '前序遍历的顺序是根、左、右，中序遍历的顺序是左、根、右，后序遍历的顺序是左、右、根。' +
    '已知前序和中序序列，或者已知后序和中序序列，可以唯一确定一棵二叉树，但仅凭前序和后序无法还原。' +
    '层序遍历需要借助队列，从根结点开始逐层访问。线索二叉树利用空指针域存放前驱和后继信息，可以加快遍历速度。' +
    '哈夫曼树是一类带权路径长度最短的二叉树，常用于构造最优前缀编码。' +
    '总之，掌握四种遍历方式与由遍历序列还原二叉树的方法是本章的核心要求。'
};

function setAiTool(tool) {
  aiTool = tool;
  $$('#aiTabs .ai-tab').forEach((b) => b.classList.toggle('is-active', b.dataset.tool === tool));
  $('#aiInputLabel').textContent = AI_PLACEHOLDER[tool][0];
  $('#aiText').placeholder = AI_PLACEHOLDER[tool][1];
  $('#aiResult').innerHTML = `
    <div class="placeholder-box">
      <p>结果会显示在这里。</p>
      <p class="small">当前工具：${esc({ solve: '题目辅助解析', extract: '知识点提炼', summary: '资料智能总结' }[tool])}</p>
    </div>`;
}

function runAi() {
  const text = $('#aiText').value.trim();
  if (!text) { toast('先粘入一些内容'); return; }

  let html = '';
  if (aiTool === 'solve') {
    const res = solveProblem(text);
    if (!res) { toast('内容太短，无法解析'); return; }
    html = solveHtml(res);
  } else if (aiTool === 'extract') {
    const res = extractKnowledge(text);
    if (!res) { toast('内容太短，无法提炼'); return; }
    html = extractHtml(res);
  } else {
    const res = summarizeText(text);
    if (!res) { toast('内容太短，无法总结'); return; }
    html = summaryHtml(res);
  }
  $('#aiResult').innerHTML = html;
}

/* ---------------------------------------------------------
  15. 表单处理
   --------------------------------------------------------- */
async function submitQuestion(e) {
  e.preventDefault();
  if (!requireLogin('发布提问')) return;

  const title = $('#askTitle').value.trim();
  const body = $('#askBody').value.trim();
  const course = $('#askCourse').value;
  if (!title) { toast('请填写问题标题'); return; }
  if (!body) { toast('请填写问题描述'); return; }

  const tags = $('#askTags').value.split(/[,，、\s]+/).map((s) => s.trim()).filter(Boolean).slice(0, 4);
  const btn = e.target.querySelector('button[type="submit"]');
  setBusy(btn, true, '发布中…');

  try {
    const row = await CloudData.insertQuestion({
      title,
      body,
      course,
      tags,
      author: Store.nickname()
    });
    await refresh();
    closeModal();
    toast('问题已发布，等待同学回答');
    navigate('q/' + row.id);
  } catch (err) {
    toast(err.message);
  } finally {
    setBusy(btn, false);
  }
}

async function submitUpload(e) {
  e.preventDefault();
  if (!requireLogin('上传资料')) return;

  const title = $('#upTitle').value.trim();
  const course = $('#upCourse').value;
  const type = $('#upType').value;
  const desc = $('#upDesc').value.trim();
  const fileInput = $('#upFile');
  const file = fileInput && fileInput.files ? fileInput.files[0] : null;

  if (!title) { toast('请填写资料名称'); return; }

  const badFile = CloudData.validateFile(file);
  if (badFile) { toast(badFile); return; }

  const btn = e.target.querySelector('button[type="submit"]');
  setBusy(btn, true, '上传中…');

  try {
    const path = CloudData.buildPath(Store.userId(), file.name);
    await CloudData.uploadFile(path, file);

    await CloudData.insertResource({
      title,
      course,
      type,
      description: desc || '上传者未填写简介。',
      author: Store.nickname(),
      file_path: path,
      file_name: file.name,
      file_size: file.size
    });

    await refresh();
    closeModal();
    toast('资料已上传，同学们可以下载了');
    if (parseHash().route === 'resources') applyRoute(); else navigate('resources');
  } catch (err) {
    toast(err.message);
  } finally {
    setBusy(btn, false);
  }
}

async function submitAnswer() {
  if (!requireLogin('发布回答')) return;

  const { param } = parseHash();
  const q = Store.question(param);
  if (!q) { toast('问题不存在或已被删除'); return; }

  const text = $('#answerText').value.trim();
  if (text.length < 5) { toast('回答太短了，多写两句吧'); return; }

  const btn = $('#answerSubmit');
  setBusy(btn, true, '发布中…');

  try {
    await CloudData.insertAnswer({
      question_id: Number(q.id),
      body: text,
      author: Store.nickname()
    });
    await refresh();
    toast('回答已发布');
    applyRoute();
  } catch (err) {
    toast(err.message);
  } finally {
    setBusy(btn, false);
  }
}

/* ---------------------------------------------------------
  16. 事件绑定
   --------------------------------------------------------- */
function bindEvents() {
  // 主导航按钮（发布类动作都需要登录）
  const ask = () => { if (requireLogin('发布提问')) openAskModal(); };
  const upload = () => { if (requireLogin('上传资料')) openUploadModal(); };
  $('#navAsk').addEventListener('click', ask);
  $('#heroAsk').addEventListener('click', ask);
  $('#qaAsk').addEventListener('click', ask);
  $('#qaEmptyAsk').addEventListener('click', ask);
  $('#heroUpload').addEventListener('click', upload);
  $('#rUpload').addEventListener('click', upload);
  $('#rEmptyUpload').addEventListener('click', upload);

  // 顶栏账号区：登录 / 进入我的 / 退出
  $('#authArea').addEventListener('click', (e) => {
    if (e.target.closest('#navLogin')) { openAuthModal(); return; }
    if (e.target.closest('#navUser')) { navigate('mine'); return; }
    if (e.target.closest('#navLogout')) { doSignOut(); }
  });
  $('#homeMoreQ').addEventListener('click', () => navigate('qa'));
  $('#homeMoreR').addEventListener('click', () => navigate('resources'));

  // 首页搜索
  $('#heroSearchForm').addEventListener('submit', (e) => {
    e.preventDefault();
    const k = $('#heroSearch').value.trim();
    qaState.keyword = k;
    rState.keyword = k;
    if (!k) { navigate('qa'); return; }
    // 按命中数量决定去答疑区还是资料库
    const qHit = Store.questions().filter((q) =>
      (q.title + q.body).toLowerCase().includes(k.toLowerCase())).length;
    const rHit = Store.resources().filter((r) =>
      (r.title + r.desc).toLowerCase().includes(k.toLowerCase())).length;
    navigate(rHit > qHit ? 'resources' : 'qa');
  });

  // 首页课程卡片 / 动态跳转
  $('#courseGrid').addEventListener('click', (e) => {
    const btn = e.target.closest('[data-course]');
    if (!btn) return;
    qaState.course = btn.dataset.course;
    qaState.keyword = '';
    navigate('qa');
  });
  $('#heroFeed').addEventListener('click', (e) => {
    const li = e.target.closest('[data-jump]');
    if (li) navigate('q/' + li.dataset.jump);
  });
  $('#homeQuestions').addEventListener('click', (e) => {
    const item = e.target.closest('[data-qid]');
    if (item) navigate('q/' + item.dataset.qid);
  });
  $('#homeResources').addEventListener('click', (e) => {
    const item = e.target.closest('[data-rid]');
    if (item) navigate('resources');
  });

  // 答疑区
  $('#courseFilter').addEventListener('click', (e) => {
    const btn = e.target.closest('[data-course]');
    if (!btn) return;
    qaState.course = btn.dataset.course;
    renderQa();
  });
  $('#statusFilter').addEventListener('click', (e) => {
    const btn = e.target.closest('[data-status]');
    if (!btn) return;
    qaState.status = btn.dataset.status;
    $$('#statusFilter .filter-item').forEach((b) => b.classList.toggle('is-active', b === btn));
    renderQa();
  });
  $('#qaSearch').addEventListener('input', (e) => { qaState.keyword = e.target.value.trim(); renderQa(); });
  $('#qaSort').addEventListener('change', (e) => { qaState.sort = e.target.value; renderQa(); });
  $('#qaList').addEventListener('click', (e) => {
    const item = e.target.closest('[data-qid]');
    if (item) navigate('q/' + item.dataset.qid);
  });

  // 问题详情
  $('#qBack').addEventListener('click', () => navigate('qa'));
  $('#qDetail').addEventListener('click', async (e) => {
    const { param } = parseHash();

    if (e.target.closest('#qBack')) return;
    if (e.target.closest('[data-open="login"]')) { openAuthModal(); return; }

    if (e.target.closest('#qdAi')) {
      const q = Store.question(param);
      if (q) openAiSolveModal(q.title + '。' + q.body, q.title);
      return;
    }

    if (e.target.closest('#qdDel')) {
      if (!requireLogin('删除问题')) return;
      const q = Store.question(param);
      if (!q || !Store.isMine(q)) { toast('只有提问者本人可以删除该问题'); return; }
      if (!window.confirm('确定删除这个问题吗？问题下的回答也会一并删除，且无法恢复。')) return;
      try {
        await CloudData.deleteQuestion(q.id);
        await refresh();
        toast('问题已删除');
        navigate('qa');
      } catch (err) {
        toast(err.message);
      }
      return;
    }

    if (e.target.closest('#answerSubmit')) { submitAnswer(); return; }

    const btn = e.target.closest('[data-act]');
    if (!btn) return;
    const wrap = e.target.closest('[data-aid]');
    if (!wrap) return;

    const q = Store.question(param);
    if (!q) return;
    const a = (q.answers || []).find((x) => x.id === wrap.dataset.aid);
    if (!a) return;
    const act = btn.dataset.act;

    if (act === 'vote') {
      if (!requireLogin('标记有帮助')) return;
      setBusy(btn, true, '…');
      try {
        await CloudData.toggleVote(a.id);
        await refresh();
        applyRoute();
        toast(Store.hasVoted(a.id) ? '已标记为有帮助' : '已取消标记');
      } catch (err) {
        toast(err.message);
        setBusy(btn, false);
      }
      return;
    }

    if (act === 'accept') {
      if (!requireLogin('采纳回答')) return;
      if (!Store.isMine(q)) { toast('只有提问者本人可以采纳回答'); return; }
      const next = q.acceptedAnswerId === a.id ? null : a.id;
      setBusy(btn, true, '…');
      try {
        await CloudData.setAcceptedAnswer(q.id, next);
        await refresh();
        applyRoute();
        toast(next ? '已采纳该回答' : '已取消采纳');
      } catch (err) {
        toast(err.message);
        setBusy(btn, false);
      }
      return;
    }

    if (act === 'del') {
      if (!requireLogin('删除回答')) return;
      if (!Store.isMine(a)) { toast('只有回答者本人可以删除该回答'); return; }
      if (!window.confirm('确定删除这条回答吗？')) return;
      try {
        await CloudData.deleteAnswer(a.id);
        await refresh();
        applyRoute();
        toast('回答已删除');
      } catch (err) {
        toast(err.message);
      }
    }
  });

  // 资料库
  $('#rSearch').addEventListener('input', (e) => { rState.keyword = e.target.value.trim(); renderResources(); });
  $('#rCourse').addEventListener('change', (e) => { rState.course = e.target.value; renderResources(); });
  $('#rTypeFilter').addEventListener('click', (e) => {
    const btn = e.target.closest('[data-type]');
    if (!btn) return;
    rState.type = btn.dataset.type;
    $$('#rTypeFilter .chip').forEach((b) => b.classList.toggle('is-active', b === btn));
    renderResources();
  });
  $('#resourceGrid').addEventListener('click', async (e) => {
    const card = e.target.closest('[data-rid]');
    if (!card) return;

    if (e.target.closest('[data-act="download"]')) {
      const r = Store.resource(card.dataset.rid);
      if (!r) return;
      if (!requireLogin('下载资料')) return;
      if (!r.filePath) { toast('这是一条示例条目，未附带真实文件。'); return; }

      const btn = e.target.closest('[data-act="download"]');
      setBusy(btn, true, '准备中…');
      try {
        const url = await CloudData.getDownloadUrl(r.filePath, 600);
        if (!url) throw new Error('未能生成下载链接，请稍后重试。');
        await CloudData.bumpResourceDownload(r.id);
        window.open(url, '_blank', 'noopener');
        await refresh();
        applyRoute();
        toast('已开始下载《' + r.title + '》');
      } catch (err) {
        toast(err.message);
        setBusy(btn, false);
      }
      return;
    }

    toast('资料详情页将在后续版本中提供');
  });

  // AI 页面
  $('#aiTabs').addEventListener('click', (e) => {
    const btn = e.target.closest('[data-tool]');
    if (btn) setAiTool(btn.dataset.tool);
  });
  $('#aiRun').addEventListener('click', runAi);
  $('#aiText').addEventListener('input', (e) => { $('#aiCharCount').textContent = e.target.value.length; });
  $('#aiSample').addEventListener('click', () => {
    $('#aiText').value = AI_SAMPLE[aiTool];
    $('#aiCharCount').textContent = AI_SAMPLE[aiTool].length;
    runAi();
  });

  // 我的
  $('#mineTabs').addEventListener('click', (e) => {
    const btn = e.target.closest('[data-mine]');
    if (!btn) return;
    mineState = btn.dataset.mine;
    $$('#mineTabs .mine-tab').forEach((b) => b.classList.toggle('is-active', b === btn));
    renderMine();
  });
  $('#nickname').addEventListener('change', async (e) => {
    if (!requireLogin('修改昵称')) { renderMine(); return; }
    const v = e.target.value.trim() || defaultNickname();
    e.target.value = v;
    try {
      await CloudData.saveNickname(Store.userId(), v);
      await refresh();
      renderAuthArea();
      renderMine();
      toast('昵称已更新：' + v);
    } catch (err) {
      toast(err.message);
      renderMine();
    }
  });
  $('#mineBody').addEventListener('click', (e) => {
    const item = e.target.closest('[data-qid]');
    if (item) { navigate('q/' + item.dataset.qid); return; }
    const open = e.target.closest('[data-open]');
    if (!open) return;
    const kind = open.dataset.open;
    if (kind === 'login') openAuthModal();
    if (kind === 'ask') { if (requireLogin('发布提问')) openAskModal(); }
    if (kind === 'qa') navigate('qa');
    if (kind === 'upload') { if (requireLogin('上传资料')) openUploadModal(); }
  });

  // 弹窗内的动态表单
  $('#modal').addEventListener('click', (e) => {
    if (e.target.dataset.close !== undefined) { closeModal(); return; }

    // 登录弹窗：验证码按钮 / 模式切换 / 第三方登录
    const act = e.target.closest('[data-auth]');
    if (act) { handleAuthAction(act.dataset.auth, act); return; }

    const tab = e.target.closest('#authTabs .auth-tab');
    if (tab) { authState.method = tab.dataset.method; renderAuthBody(); return; }

    if (e.target.closest('#authWechat')) { startWechatLogin(); return; }

    if (e.target.closest('#askAi')) {
      const text = $('#askBody').value.trim() || $('#askTitle').value.trim();
      if (!text) { toast('先写下问题内容'); return; }
      openAiSolveModal(text, $('#askTitle').value.trim() || '基于你的问题描述');
    }
  });
  $('#modal').addEventListener('input', (e) => {
    if (e.target.id === 'authPhone') setFieldError('phoneError', '');
  });
  $('#modal').addEventListener('submit', (e) => {
    if (e.target.id === 'askForm') submitQuestion(e);
    if (e.target.id === 'uploadForm') submitUpload(e);
    if (e.target.id === 'emailForm') submitEmailForm(e, e.target.querySelector('button[type="submit"]'));
    if (e.target.id === 'phoneForm') submitPhoneForm(e, e.target.querySelector('button[type="submit"]'));
  });
  $('#modalClose').addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

  window.addEventListener('hashchange', applyRoute);
}

/* ---------------------------------------------------------
   17. 启动
   --------------------------------------------------------- */
async function init() {
  renderAuthArea();
  bindEvents();
  setAiTool('solve');
  applyRoute();

  if (!CloudAuth.enabled) {
    showCloudNotice(CloudAuth.initError || '云端服务未就绪，暂时无法读取或发布内容。');
    return;
  }

  // 微信授权回调必须最先处理：它会消费掉 URL 上一次性的 code
  let callback = { session: null, error: null };
  try {
    callback = await CloudAuth.handleWechatCallback();
  } catch (e) {
    callback = { session: null, error: '微信登录回调处理失败，请重新登录。' };
  }
  if (callback.error) toast(callback.error);
  if (callback.session) {
    // 登录成功后立刻清掉地址栏上的 code / state，否则刷新会重放已消费的 code
    history.replaceState(null, '', location.pathname + location.hash);
  }

  let session = callback.session;
  if (!session) {
    const current = await CloudAuth.getSession();
    if (current.error) toast(current.error);
    session = current.session;
  }

  if (session) {
    await finishSignIn(session, { silent: true });
  } else {
    authState.session = null;
    db.userId = null;
    await loadPublicContent();
  }

  CloudAuth.onAuthStateChange((event, s) => {
    authState.session = s || null;
    if (event === 'SIGNED_OUT') { db.userId = null; renderAuthArea(); }
  });
}

/** 未登录时的公开浏览：全部内容对访问者都是可读的 */
async function loadPublicContent() {
  try {
    await refresh();
  } catch (err) {
    showCloudNotice('内容加载失败：' + err.message);
  }
  applyRoute();
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', init);
} else {
  init();
}
