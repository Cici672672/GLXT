_Wed, 14 Oct 2026 14:32:01 GMTTMISS_$feeedb1d-b90d-43e2-af23-0b20a768df36U30368�/0fg_NSMutableDictionary�fh3\NSDictionary�/0jk_NSHTTPURLResponse�lm3_NSHTTPURLResponse]NSURLResponse␀␀␀␀$␀)␀2␀7␀I␀L␀b␀d␀�␀�␀�␀�␀�␀�5<^ad����������������������'069BKMOV^itvxz|~������������������������5Gj��$)PV[qu�����␀␀␀␀␀␀␀␀␀␀␀␀␀n␀␀␀␀␀␀␀␀␀␀␀␀␀␀�_/https://scnu-study-hub.app.workbuddy.host/ai.js� !Oe�/* =========================================================
   学业互助 · 华师答疑资源共享平台
   暖色系 / 简洁 / 无动画
   ========================================================= */

:root {
  --bg: #FBF9F5;
  --bg-warm: #F7F1E9;
  --surface: #FFFFFF;
  --surface-2: #FBF6F0;
  --primary: #C0552F;
  --primary-dark: #9E4223;
  --primary-soft: #F9E6DC;
  --accent: #D89B3C;
  --accent-soft: #FBF0DC;
  --ok: #4F7A55;
  --ok-soft: #E9F1E7;
  --text: #33251E;
  --text-2: #6A5648;
  --muted: #9B8577;
  --line: #EFE4D8;
  --line-strong: #E2D2C2;
  --danger: #B23A2C;
  --radius: 14px;
  --radius-sm: 9px;
  --shadow: 0 2px 10px rgba(120, 82, 56, 0.07);
  --shadow-lg: 0 14px 40px rgba(120, 82, 56, 0.14);
  --serif: "Songti SC", "STSong", "Noto Serif SC", Georgia, serif;
  --sans: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Source Han Sans SC", sans-serif;
}

*, *::before, *::after {
  box-sizing: border-box;
  transition: none !important;
  animation: none !important;
}

/* hidden 属性优先级最高，避免被 display 规则覆盖 */
[hidden] { display: none !important; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: var(--sans);
  font-size: 15px;
  line-height: 1.75;
  -webkit-font-smoothing: antialiased;
}

h1, h2, h3, h4 { margin: 0; font-weight: 700; line-height: 1.4; }
p { margin: 0; }
a { color: inherit; text-decoration: none; }
button { font-family: inherit; cursor: pointer; }
i { font-style: normal; }
ul { margin: 0; padding: 0; list-style: none; }

.wrap { max-width: 1180px; margin: 0 auto; padding: 0 24px; }
.wrap.narrow { max-width: 840px; }
.small { font-size: 12.5px; color: var(--muted); }

/* ---------------- 顶部导航 ---------------- */
.site-header {
  position: sticky; top: 0; z-index: 50;
  background: rgba(251, 249, 245, 0.95);
  border-bottom: 1px solid var(--line);
  backdrop-filter: saturate(140%) blur(6px);
}
.header-inner { display: flex; align-items: center; gap: 26px; height: 66px; }
.brand { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
.brand-mark {
  display: grid; place-items: center;
  width: 38px; height: 38px; border-radius: 10px;
  background: var(--primary); color: #fff;
  font-family: var(--serif); font-size: 19px;
}
.brand-text { display: flex; flex-direction: column; line-height: 1.25; }
.brand-text strong { font-size: 16px; letter-spacing: 0.5px; }
.brand-text em { font-size: 11px; color: var(--muted); font-style: normal; letter-spacing: 0.5px; }

.nav { display: flex; gap: 4px; margin-left: auto; }
.nav a { padding: 7px 13px; border-radius: 20px; font-size: 14px; color: var(--text-2); }
.nav a:hover { background: var(--primary-soft); color: var(--primary-dark); }
.nav a.is-active { background: var(--primary); color: #fff; }

/* ---------------- 按钮 ---------------- */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 6px;
  border: 1px solid transparent; border-radius: 20px;
  padding: 10px 22px; font-size: 14.5px; font-weight: 500;
  background: none; color: var(--text);
}
.btn-primary { background: var(--primary); color: #fff; box-shadow: var(--shadow); }
.btn-primary:hover { background: var(--primary-dark); }
.btn-soft { background: var(--primary-soft); color: var(--primary-dark); border-color: #F0D3C3; }
.btn-soft:hover { background: #F5D9C9; }
.btn-ghost { border-color: var(--line-strong); background: var(--surface); color: var(--text-2); }
.btn-ghost:hover { border-color: var(--primary); color: var(--primary-dark); }
.btn-text { color: var(--muted); }
.btn-text:hover { color: var(--danger); }
.btn-sm { padding: 7px 15px; font-size: 13.5px; }
.btn-block { width: 100%; }

/* ---------------- 首页 Hero ---------------- */
.hero {
  background:
    radial-gradient(880px 340px at 10% -10%, #F8E7D8 0%, rgba(248, 231, 216, 0) 62%),
    radial-gradient(680px 300px at 94% 2%, #FAF0DC 0%, rgba(250, 240, 220, 0) 60%),
    var(--bg);
  border-bottom: 1px solid var(--line);
  padding: 58px 0 52px;
}
.hero-inner { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 44px; align-items: center; }
.pill {
  display: inline-block; padding: 5px 14px; border-radius: 20px;
  background: var(--accent-soft); color: #9A6A1C;
  font-size: 12.5px; letter-spacing: 0.5px; margin-bottom: 18px;
}
.hero h1 { font-family: var(--serif); font-size: 44px; line-height: 1.3; letter-spacing: 1px; color: #2C1F18; }
.lead { margin-top: 16px; font-size: 15.5px; color: var(--text-2); max-width: 32em; }

.hero-search { display: flex; gap: 10px; margin-top: 26px; max-width: 560px; }
.hero-search input { flex: 1; }
.hero-actions { display: flex; gap: 12px; margin-top: 16px; flex-wrap: wrap; }

.hero-card {
  background: var(--surface); border: 1px solid var(--line);
  border-radius: var(--radius); padding: 22px 24px; box-shadow: var(--shadow-lg);
}
.hero-card h4 { font-size: 15px; margin-bottom: 14px; color: var(--primary-dark); }
.hero-feed li {
  display: flex; gap: 10px; align-items: baseline;
  padding: 9px 0; border-bottom: 1px dashed var(--line);
  font-size: 13.5px;
}
.hero-feed li:last-child { border-bottom: none; }
.hero-feed .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); flex-shrink: 0; margin-top: 8px; }
.hero-feed .t { flex: 1; color: var(--text-2); }
.hero-feed .c { font-size: 12px; color: var(--muted); white-space: nowrap; }

/* ---------------- 统计 ---------------- */
.stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin: 44px 0 8px; }
.stat { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px 22px; }
.stat b { display: block; font-size: 30px; font-family: var(--serif); color: var(--primary); line-height: 1.2; }
.stat span { font-size: 13px; color: var(--muted); }

/* ---------------- 标题 ---------------- */
.section-title { font-family: var(--serif); font-size: 24px; margin: 52px 0 0; letter-spacing: 0.5px; }
.section-sub { color: var(--text-2); margin-top: 8px; font-size: 14px; }
.sub-title { font-size: 17px; margin: 40px 0 14px; }
.page-title { font-family: var(--serif); font-size: 30px; letter-spacing: 0.5px; margin-bottom: 6px; }
.page-sub { color: var(--muted); font-size: 14px; }
.page-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-bottom: 24px; }
.back-link { border: none; background: none; color: var(--muted); font-size: 13.5px; padding: 0; margin-bottom: 16px; }
.back-link:hover { color: var(--primary-dark); }

/* ---------------- 卡片 ---------------- */
.card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; box-shadow: var(--shadow); }
.grid { display: grid; gap: 18px; margin-top: 22px; }
.grid-3 { grid-template-columns: repeat(3, 1fr); }
.feature h3 { font-size: 17px; margin-bottom: 8px; }
.feature p { color: var(--text-2); font-size: 14px; }
.feature-icon { width: 42px; height: 42px; border-radius: 12px; display: grid; place-items: center; font-size: 20px; background: var(--primary-soft); margin-bottom: 14px; }

/* ---------------- 课程网格 ---------------- */
.course-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 20px; }
.course-card {
  background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
  padding: 16px 18px; text-align: left; box-shadow: var(--shadow);
}
.course-card:hover { border-color: var(--primary); }
.course-card .cname { font-size: 14.5px; font-weight: 600; color: var(--text); display: block; }
.course-card .cmeta { font-size: 12.5px; color: var(--muted); margin-top: 6px; display: block; }
.course-card .cdept { font-size: 11.5px; color: var(--primary); background: var(--primary-soft); border-radius: 10px; padding: 2px 8px; display: inline-block; margin-bottom: 8px; }

/* ---------------- 两栏 ---------------- */
.two-col { display: grid; grid-template-columns: 1.35fr 0.65fr; gap: 36px; align-items: start; }

/* ---------------- 问题列表 ---------------- */
.q-list { display: flex; flex-direction: column; gap: 12px; margin-top: 18px; }
.q-item {
  display: flex; gap: 16px; background: var(--surface); border: 1px solid var(--line);
  border-radius: var(--radius); padding: 16px 18px; box-shadow: var(--shadow); cursor: pointer;
}
.q-item:hover { border-color: var(--primary); }
.q-stats { display: flex; flex-direction: column; gap: 6px; align-items: center; flex-shrink: 0; width: 62px; }
.q-stats .num { font-family: var(--serif); font-size: 17px; color: var(--primary); line-height: 1.2; }
.q-stats .lbl { font-size: 11px; color: var(--muted); }
.q-body { flex: 1; min-width: 0; }
.q-body h3 { font-size: 16px; margin-bottom: 6px; line-height: 1.5; }
.q-body h3:hover { color: var(--primary-dark); }
.q-excerpt { font-size: 13.5px; color: var(--text-2); margin-bottom: 9px; }
.q-meta { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; font-size: 12px; color: var(--muted); }

.tag { display: inline-block; font-size: 11.5px; padding: 2px 9px; border-radius: 11px; background: var(--surface-2); border: 1px solid var(--line); color: var(--text-2); }
.tag.course { background: var(--primary-soft); border-color: #F0D3C3; color: var(--primary-dark); }
.tag.solved { background: var(--ok-soft); border-color: #D6E4D3; color: var(--ok); }
.tag.open { background: var(--accent-soft); border-color: #F0DDBB; color: #96681A; }

/* ---------------- 资料迷你列表 ---------------- */
.r-mini-list { display: flex; flex-direction: column; gap: 10px; margin-top: 18px; }
.r-mini {
  display: flex; gap: 12px; align-items: center;
  background: var(--surface); border: 1px solid var(--line);
  border-radius: var(--radius-sm); padding: 12px 14px; cursor: pointer;
}
.r-mini:hover { border-color: var(--primary); }
.r-mini .ricon {
  width: 36px; height: 36px; border-radius: 9px; flex-shrink: 0;
  display: grid; place-items: center; background: var(--accent-soft); font-size: 16px;
}
.r-mini .rtxt { flex: 1; min-width: 0; }
.r-mini .rtitle { font-size: 13.5px; font-weight: 600; }
.r-mini .rsub { font-size: 11.5px; color: var(--muted); }

/* ---------------- 答疑区布局 ---------------- */
.qa-layout { display: grid; grid-template-columns: 232px 1fr; gap: 30px; align-items: start; }
.filter-panel { position: sticky; top: 84px; display: flex; flex-direction: column; gap: 22px; }
.filter-block h4 { font-size: 13px; color: var(--muted); letter-spacing: 0.5px; margin-bottom: 10px; font-weight: 600; }
.filter-list { display: flex; flex-direction: column; gap: 3px; }
.filter-item {
  display: flex; align-items: center; justify-content: space-between; gap: 8px;
  border: none; background: none; text-align: left;
  padding: 7px 11px; border-radius: 8px; font-size: 13.5px; color: var(--text-2);
}
.filter-item:hover { background: var(--surface-2); }
.filter-item.is-active { background: var(--primary); color: #fff; }
.filter-item.is-active i { color: rgba(255, 255, 255, 0.8); }
.filter-item i { font-size: 11.5px; color: var(--muted); }
.qa-main { min-width: 0; }

/* ---------------- 工具栏 ---------------- */
.toolbar { display: flex; gap: 10px; align-items: center; margin-bottom: 18px; }
.toolbar input[type="search"] { flex: 1; }
.toolbar-wrap { flex-wrap: wrap; }
.select-wrap { position: relative; }
.select-wrap select { min-width: 140px; }

/* ---------------- 资料卡片 ---------------- */
.resource-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
.resource-card {
  display: flex; flex-direction: column; gap: 10px;
  background: var(--surface); border: 1px solid var(--line);
  border-radius: var(--radius); padding: 18px 20px; box-shadow: var(--shadow);
}
.resource-card:hover { border-color: var(--primary); }
.rc-head { display: flex; align-items: flex-start; gap: 12px; }
.rc-icon { width: 40px; height: 40px; border-radius: 10px; display: grid; place-items: center; font-size: 18px; background: var(--accent-soft); flex-shrink: 0; }
.rc-head h3 { font-size: 15.5px; line-height: 1.5; }
.rc-desc { font-size: 13.5px; color: var(--text-2); flex: 1; }
.rc-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; border-top: 1px solid var(--line); padding-top: 11px; font-size: 12px; color: var(--muted); flex-wrap: wrap; }
.stars { color: var(--accent); letter-spacing: 1px; }

/* ---------------- 表单 ---------------- */
.form { display: flex; flex-direction: column; gap: 18px; }
.field { display: flex; flex-direction: column; gap: 8px; position: relative; }
.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.label { font-size: 13.5px; font-weight: 600; color: var(--text-2); }
.label i { color: var(--danger); }

input[type="text"], input[type="email"], input[type="search"],
input[type="number"], textarea, select {
  width: 100%; padding: 11px 14px;
  border: 1px solid var(--line-strong); border-radius: var(--radius-sm);
  background: var(--surface-2); color: var(--text);
  font-family: inherit; font-size: 14.5px; outline: none;
}
textarea { resize: vertical; line-height: 1.8; }
input:focus, textarea:focus, select:focus {
  border-color: var(--primary); background: #fff;
  box-shadow: 0 0 0 3px rgba(192, 85, 47, 0.12);
}
.counter-inline { font-size: 12.5px; color: var(--muted); }
.counter-inline b { color: var(--primary); }

.chip-row { display: flex; gap: 8px; flex-wrap: wrap; }
.chip { border: 1px solid var(--line-strong); background: var(--surface-2); border-radius: 20px; padding: 7px 15px; font-size: 13px; color: var(--text-2); }
.chip:hover, .chip.is-active { border-color: var(--primary); background: var(--primary-soft); color: var(--primary-dark); }

/* ---------------- AI 页面 ---------------- */
.ai-tabs { display: flex; gap: 8px; flex-wrap: wrap; margin: 20px 0 18px; }
.ai-tab {
  border: 1px solid var(--line-strong); background: var(--surface);
  border-radius: 22px; padding: 9px 20px; font-size: 14px; color: var(--text-2);
}
.ai-tab:hover { border-color: var(--primary); }
.ai-tab.is-active { background: var(--primary); color: #fff; border-color: var(--primary); }

.ai-work { display: grid; grid-template-columns: 1fr 1.1fr; gap: 22px; align-items: start; }
.ai-input { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px; box-shadow: var(--shadow); display: flex; flex-direction: column; gap: 12px; }
.ai-input-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
.ai-btns { display: flex; gap: 8px; }
.ai-result { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px; box-shadow: var(--shadow); min-height: 260px; }
.placeholder-box { color: var(--muted); font-size: 13.5px; display: flex; flex-direction: column; gap: 6px; padding: 30px 0; text-align: center; }

.ai-sec { margin-bottom: 20px; }
.ai-sec:last-child { margin-bottom: 0; }
.ai-sec h4 { font-size: 13px; color: var(--primary-dark); letter-spacing: 0.5px; margin-bottom: 10px; }
.ai-sec .lead-line { font-size: 14.5px; }
.badge-row { display: flex; gap: 8px; flex-wrap: wrap; }

.step-list { counter-reset: st; display: flex; flex-direction: column; gap: 10px; list-style: none; margin: 0; padding: 0; }
.step-list li { position: relative; padding-left: 30px; font-size: 14px; color: var(--text-2); }
.step-list li::before {
  counter-increment: st; content: counter(st);
  position: absolute; left: 0; top: 3px;
  width: 20px; height: 20px; border-radius: 50%;
  background: var(--primary-soft); color: var(--primary-dark);
  font-size: 11.5px; display: grid; place-items: center; font-weight: 600;
}
.bullet-list li { position: relative; padding-left: 16px; font-size: 14px; color: var(--text-2); margin-bottom: 6px; }
.bullet-list li::before { content: ""; position: absolute; left: 2px; top: 11px; width: 5px; height: 5px; border-radius: 50%; background: var(--accent); }
.bullet-list.warn li::before { background: var(--danger); }

.kp-list { display: flex; flex-direction: column; gap: 10px; }
.kp { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; }
.kp .kp-tag { flex-shrink: 0; font-size: 11px; padding: 2px 8px; border-radius: 9px; background: var(--primary-soft); color: var(--primary-dark); margin-top: 4px; }
.kp.def .kp-tag { background: #E7EFF7; color: #2F5C86; }
.kp.cls .kp-tag { background: #F3E9F5; color: #7A4B85; }
.kp.prop .kp-tag { background: var(--accent-soft); color: #96681A; }
.kp.met .kp-tag { background: var(--ok-soft); color: var(--ok); }

.tech-list { margin: 0; padding-left: 20px; color: var(--text-2); font-size: 14px; list-style: disc; }
.tech-list li { margin-bottom: 8px; }
.tip { font-size: 12.5px; color: var(--muted); margin-top: 14px; }

/* ---------------- 问题详情 ---------------- */
.qd-head h1 { font-family: var(--serif); font-size: 26px; line-height: 1.45; margin-bottom: 12px; }
.qd-meta { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; font-size: 12.5px; color: var(--muted); margin-bottom: 18px; }
.qd-body { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 22px 24px; box-shadow: var(--shadow); white-space: pre-wrap; line-height: 1.95; font-size: 14.8px; }
.answer-block { margin-top: 30px; }
.answer-block h3 { font-size: 17px; margin-bottom: 14px; }
.answer {
  background: var(--surface); border: 1px solid var(--line); border-left: 3px solid var(--line-strong);
  border-radius: var(--radius-sm); padding: 16px 18px; margin-bottom: 12px;
}
.answer.accepted { border-left-color: var(--ok); background: #FCFEFB; }
.answer-head { display: flex; align-items: center; gap: 10px; margin-bottom: 9px; font-size: 12.5px; color: var(--muted); flex-wrap: wrap; }
.answer-head .who { font-weight: 600; color: var(--text-2); font-size: 13.5px; }
.answer-body { font-size: 14.5px; white-space: pre-wrap; line-height: 1.9; }
.answer-foot { display: flex; gap: 14px; align-items: center; margin-top: 12px; font-size: 12.5px; color: var(--muted); }
.icon-btn { border: none; background: none; color: var(--muted); font-size: 12.5px; padding: 2px 4px; }
.icon-btn:hover { color: var(--primary-dark); }
.icon-btn.del:hover { color: var(--danger); }
.icon-btn.on { color: var(--primary); font-weight: 600; }
.answer-form { margin-top: 18px; display: flex; flex-direction: column; gap: 12px; }
.answer-form .row { display: flex; gap: 10px; align-items: center; }

/* ---------------- 我的 ---------------- */
.profile { display: flex; align-items: center; gap: 16px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 22px; box-shadow: var(--shadow); margin-bottom: 24px; }
.avatar { width: 52px; height: 52px; border-radius: 50%; background: var(--primary); color: #fff; display: grid; place-items: center; font-family: var(--serif); font-size: 22px; flex-shrink: 0; }
.profile-info { flex: 1; max-width: 280px; }
.profile-info input { padding: 7px 12px; font-size: 15px; font-weight: 600; }

.mine-tabs { display: flex; gap: 6px; background: var(--surface-2); border: 1px solid var(--line); border-radius: 22px; padding: 4px; width: fit-content; margin-bottom: 20px; }
.mine-tab { border: none; background: none; padding: 8px 18px; border-radius: 18px; font-size: 13.5px; color: var(--text-2); }
.mine-tab.is-active { background: var(--primary); color: #fff; }
.mine-tab i { font-size: 11.5px; color: inherit; opacity: 0.75; }

/* ---------------- 关于 ---------------- */
.about-card { margin-bottom: 18px; }
.about-card h3 { font-size: 16px; margin: 20px 0 8px; color: var(--primary-dark); }
.about-card h3:first-child { margin-top: 0; }
.about-card p { color: var(--text-2); font-size: 14px; }
.dot-list { margin: 8px 0 0; padding-left: 20px; color: var(--text-2); font-size: 14px; list-style: disc; }
.dot-list li { margin-bottom: 5px; }

/* ---------------- 弹窗 ---------------- */
.modal { position: fixed; inset: 0; z-index: 100; display: grid; place-items: center; padding: 24px; }
.modal-mask { position: absolute; inset: 0; background: rgba(51, 37, 30, 0.42); }
.modal-box {
  position: relative; width: min(680px, 100%); max-height: 88vh; overflow-y: auto;
  background: var(--surface); border-radius: 18px; box-shadow: var(--shadow-lg); padding: 30px;
}
.modal-box.wide { width: min(820px, 100%); }
.modal-close { position: absolute; top: 12px; right: 16px; border: none; background: none; font-size: 26px; line-height: 1; color: var(--muted); }
.modal-close:hover { color: var(--danger); }
.modal-box h2 { font-family: var(--serif); font-size: 22px; margin-bottom: 6px; }
.modal-sub { font-size: 13.5px; color: var(--muted); margin-bottom: 20px; }
.modal-actions { display: flex; gap: 12px; align-items: center; padding-top: 4px; }
.modal-actions .btn-text { margin-left: auto; }

/* ---------------- 空态 / Toast ---------------- */
.empty { text-align: center; padding: 60px 0; color: var(--muted); }
.empty p { margin-bottom: 14px; }
.toast {
  position: fixed; left: 50%; bottom: 34px; transform: translateX(-50%);
  background: #33251E; color: #FBF6F0; padding: 11px 22px;
  border-radius: 22px; font-size: 13.5px; z-index: 200; box-shadow: var(--shadow-lg);
}

/* ---------------- 页脚 ---------------- */
.site-footer { border-top: 1px solid var(--line); margin-top: 70px; background: var(--bg-warm); }
.footer-inner { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 28px 24px; flex-wrap: wrap; }
.footer-inner strong { font-family: var(--serif); font-size: 15px; }
.footer-inner p { font-size: 13px; color: var(--muted); margin-top: 4px; }
.footer-meta { display: flex; gap: 18px; font-size: 13px; color: var(--muted); }

/* ---------------- 顶栏账号区 ---------------- */
.header-actions { display: flex; align-items: center; gap: 10px; margin-left: auto; }
.auth-area { display: flex; align-items: center; gap: 6px; }
.auth-off { font-size: 12.5px; color: var(--danger); }
.auth-chip {
  display: inline-flex; align-items: center; gap: 8px;
  border: 1px solid var(--line-strong); background: var(--surface);
  border-radius: 20px; padding: 4px 13px 4px 4px; color: var(--text-2);
}
.auth-chip:hover { border-color: var(--primary); color: var(--primary-dark); }
.auth-avatar {
  width: 26px; height: 26px; border-radius: 50%;
  background: var(--primary-soft); color: var(--primary-dark);
  display: grid; place-items: center; font-size: 13px; font-weight: 600;
}
.auth-name { font-size: 13.5px; max-width: 8em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* 云端不可用时的提示条 */
.cloud-notice {
  background: #FBEDE8; border-bottom: 1px solid #F0D3C3; color: var(--danger);
  font-size: 13px; padding: 9px 24px; text-align: center;
}

/* ---------------- 登录弹窗 ---------------- */
.auth-tabs {
  display: flex; gap: 6px; background: var(--surface-2); border: 1px solid var(--line);
  border-radius: 20px; padding: 4px; width: fit-content; margin-bottom: 20px;
}
.auth-tab { border: none; background: none; padding: 7px 22px; border-radius: 16px; font-size: 13.5px; color: var(--text-2); }
.auth-tab.is-active { background: var(--primary); color: #fff; }
.field-btn .btn-block { width: 100%; }
.auth-divider { display: flex; align-items: center; gap: 12px; margin: 22px 0 16px; color: var(--muted); font-size: 12px; }
.auth-divider::before, .auth-divider::after { content: ""; flex: 1; height: 1px; background: var(--line); }
.form-error {
  font-size: 12.5px; color: var(--danger); background: #FBEDE8;
  border: 1px solid #F0D3C3; border-radius: var(--radius-sm); padding: 8px 12px;
}
.field-error { font-size: 12.5px; color: var(--danger); }
.warn-text { color: var(--danger); }

/* 登录弹窗底部的次级入口 */
.auth-links { display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--line-strong); }
.link-btn { border: none; background: none; padding: 0; font-size: 12.5px; color: var(--primary-dark); }
.link-btn:hover { text-decoration: underline; }

/* ---------------- 账号相关标记 ---------------- */
.tag.mine { background: #E7EFF7; border-color: #CFE0EF; color: #2F5C86; }
.tag.ghost { background: var(--surface-2); border-style: dashed; color: var(--muted); }

/* 未登录时的回答区提示 */
.answer-form.locked {
  align-items: flex-start; background: var(--surface-2);
  border: 1px dashed var(--line-strong); border-radius: var(--radius-sm); padding: 18px;
}
.answer-form.locked p { font-size: 13.5px; color: var(--text-2); }

/* 请求进行中 / 不可用的按钮 */
.btn[disabled] { opacity: 0.62; cursor: not-allowed; }
.icon-btn[disabled], .icon-btn[disabled]:hover { color: var(--line-strong); cursor: not-allowed; }

/* ---------------- 响应式 ---------------- */
@media (max-width: 1040px) {
  .hero-inner { grid-template-columns: 1fr; gap: 30px; }
  .hero h1 { font-size: 34px; }
  .two-col { grid-template-columns: 1fr; gap: 10px; }
  .grid-3, .resource-grid, .course-grid { grid-template-columns: repeat(2, 1fr); }
  .qa-layout { grid-template-columns: 1fr; }
  .filter-panel { position: static; }
  .filter-list { flex-direction: row; flex-wrap: wrap; }
  .course-filter-list { display: flex; flex-wrap: wrap; gap: 6px; }
  .ai-work { grid-template-columns: 1fr; }
}
@media (max-width: 700px) {
  .wrap { padding: 0 18px; }
  .header-inner { height: auto; padding: 10px 0; flex-wrap: wrap; }
  .nav { order: 3; width: 100%; margin-left: 0; overflow-x: auto; padding-bottom: 4px; }
  .nav a { white-space: nowrap; }
  .header-actions { order: 2; margin-left: auto; }
  .hero { padding: 38px 0 32px; }
  .hero h1 { font-size: 27px; }
  .hero-search { flex-direction: column; }
  .grid-3, .resource-grid, .course-grid, .stats, .field-row { grid-template-columns: 1fr; }
  .q-item { flex-direction: column; gap: 10px; }
  .q-stats { flex-direction: row; width: auto; gap: 14px; }
  .q-stats .num { font-size: 15px; }
  .modal-box { padding: 24px 18px; }
}
