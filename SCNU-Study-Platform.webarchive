<!-- ================= 答疑区 ================= -->
<section class="page" id="page-qa" hidden="">
  <div class="wrap">
    <div class="page-head">
      <div>
        <h2 class="page-title">答疑区</h2>
        <p class="page-sub" id="qaCount">按课程分类浏览全部问题</p>
      </div>
      <button class="btn btn-primary" id="qaAsk">＋ 发起提问</button>
    </div>

    <div class="qa-layout">
      <aside class="filter-panel">
        <div class="filter-block">
          <h4>课程分类</h4>
          <div class="filter-list" id="courseFilter"></div>
        </div>
        <div class="filter-block">
          <h4>解决状态</h4>
          <div class="filter-list" id="statusFilter">
            <button class="filter-item is-active" data-status="all">全部 <i>0</i></button>
            <button class="filter-item" data-status="open">待解答 <i>0</i></button>
            <button class="filter-item" data-status="solved">已解决 <i>0</i></button>
          </div>
        </div>
      </aside>

      <div class="qa-main">
        <div class="toolbar">
          <input type="search" id="qaSearch" placeholder="在答疑区中搜索…">
          <div class="select-wrap">
            <select id="qaSort">
              <option value="new">最新发布</option>
              <option value="answers">回答最多</option>
              <option value="views">浏览最多</option>
            </select>
          </div>
        </div>
        <div class="q-list" id="qaList"></div>
        <div class="empty" id="qaEmpty" hidden="">
          <p>没有匹配的问题。</p>
          <button class="btn btn-primary btn-sm" id="qaEmptyAsk">来提第一个问题</button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ================= 问题详情 ================= -->
<section class="page" id="page-q" hidden="">
  <div class="wrap narrow">
    <button class="back-link" id="qBack">← 返回答疑区</button>
    <div id="qDetail"></div>
  </div>
</section>

<!-- ================= 资料库 ================= -->
<section class="page" id="page-resources" hidden="">
  <div class="wrap">
    <div class="page-head">
      <div>
        <h2 class="page-title">资料共享库</h2>
        <p class="page-sub" id="rCount">课件、笔记、真题、代码，按课程归档</p>
      </div>
      <button class="btn btn-primary" id="rUpload">＋ 上传资料</button>
    </div>

    <div class="toolbar toolbar-wrap">
      <input type="search" id="rSearch" placeholder="搜索资料名称、描述或课程…">
      <div class="chip-row" id="rTypeFilter">
        <button class="chip is-active" data-type="all">全部类型</button>
        <button class="chip" data-type="课件">课件</button>
        <button class="chip" data-type="笔记">笔记</button>
        <button class="chip" data-type="真题">真题</button>
        <button class="chip" data-type="代码">代码</button>
        <button class="chip" data-type="参考书">参考书</button>
      </div>
      <div class="select-wrap">
        <select id="rCourse">
          <option value="all">全部课程</option>
        </select>
      </div>
    </div>

    <div class="resource-grid" id="resourceGrid"></div>
    <div class="empty" id="rEmpty" hidden="">
      <p>还没有匹配的资料。</p>
      <button class="btn btn-primary btn-sm" id="rEmptyUpload">上传一份资料</button>
    </div>
  </div>
</section>

<!-- ================= AI 助手 ================= -->
<section class="page" id="page-ai" hidden="">
  <div class="wrap">
    <h2 class="page-title">AI 学习助手</h2>
    <p class="page-sub">三个工具都在你的浏览器里本地运行，输入的内容不会上传到服务器。</p>

    <div class="ai-tabs" id="aiTabs">
      <button class="ai-tab is-active" data-tool="solve">🧩 题目辅助解析</button>
      <button class="ai-tab" data-tool="extract">🔍 知识点提炼</button>
      <button class="ai-tab" data-tool="summary">📝 资料智能总结</button>
    </div>

    <div class="ai-work">
      <div class="ai-input">
        <label class="label" id="aiInputLabel">把题目粘进来</label>
        <textarea id="aiText" rows="10" placeholder="例如：设二叉树的中序遍历为 DBEAFC，前序遍历为 ABDECF，求后序遍历。"></textarea>
        <div class="ai-input-foot">
          <span class="counter-inline"><b id="aiCharCount">0</b> 字</span>
          <div class="ai-btns">
            <button class="btn btn-soft btn-sm" id="aiSample">填入示例</button>
            <button class="btn btn-primary btn-sm" id="aiRun">开始分析</button>
          </div>
        </div>
      </div>
      <div class="ai-result" id="aiResult">
    <div class="placeholder-box">
      <p>结果会显示在这里。</p>
      <p class="small">当前工具：题目辅助解析</p>
    </div></div>
    </div>

    <h3 class="sub-title">能力说明</h3>
    <ul class="tech-list">
      <li><b>题目辅助解析</b>：识别题型与所属知识点，给出分层解题框架、关键提示和易错点，不直接给答案。</li>
      <li><b>知识点提炼</b>：从讲义或笔记中挑出定义、分类、性质、方法类句子，并抽出高频术语。</li>
      <li><b>资料智能总结</b>：抽取式摘要，按关键词权重与位置打分，输出摘要、要点和关键词。</li>
    </ul>
    <p class="tip">AI 输出为思路参考，正式作答前请自行核对教材与老师讲授内容。</p>
  </div>
</section>

<!-- ================= 我的 ================= -->
<section class="page" id="page-mine" hidden="">
  <div class="wrap">
    <h2 class="page-title">我的空间</h2>
    <p class="page-sub">提问、回答与上传的资料都存档在你的账号下，换台设备登录同样能看到。</p>

    <div class="profile">
      <div class="avatar" id="avatar">同</div>
