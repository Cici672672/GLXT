/* ---------------------------------------------------------
   5. AI 模块 · 题目辅助解析
   --------------------------------------------------------- */
function detectType(text) {
  const t = text.toLowerCase();
  let best = null;
  let bestScore = 0;
  QTYPES.forEach((qt) => {
    let s = 0;
    qt.kw.forEach((k) => { if (t.includes(k.toLowerCase())) s++; });
    if (s > bestScore) { bestScore = s; best = qt; }
  });
  if (best && bestScore > 0) return { type: best, matched: bestScore };
  return { type: { name: '综合题', icon: '🧠', steps: GENERIC_STEPS, kw: [] }, matched: 0 };
}

function matchTopics(text, limit = 3) {
  const t = text.toLowerCase();
  const scored = TOPICS.map((tp) => {
    let score = 0;
    const hits = [];
    tp.kw.forEach((k) => {
      const kk = k.toLowerCase();
      let from = 0;
      let c = 0;
      while (true) {
        const idx = t.indexOf(kk, from);
        if (idx === -1) break;
        c++; from = idx + kk.length;
      }
      if (c > 0) { score += c; hits.push(k); }
    });
    return { topic: tp, score, hits };
  }).filter((x) => x.score > 0).sort((a, b) => b.score - a.score);

  return scored.slice(0, limit);
}

/**
 * 题目辅助解析
 * @returns 解析结果对象
 */
function solveProblem(text) {
  const raw = String(text || '').trim();
  if (!raw) return null;

  const t = raw.toLowerCase();
  const { type, matched } = detectType(raw);
  const topics = matchTopics(raw, 3);

  // 题目特征
  const hasNumber = /\d/.test(raw);
  const hasFormula = /[=＝<>≤≥＋+\-*/×÷√∑∫]/.test(raw);
  const isLong = raw.length > 120;

  const knowledge = [];
  const pitfalls = [];
  topics.forEach((x) => {
    x.topic.points.forEach((p) => knowledge.push({ text: p, from: x.topic.name }));
    (x.topic.pitfalls || []).forEach((p) => pitfalls.push(p));
  });

  // 解题步骤 = 题型框架 + 知识点专属步骤
  let steps = type.steps.slice();
  topics.forEach((x) => {
    if (x.topic.steps) steps = steps.concat(x.topic.steps.map((s) => `【${x.topic.name}】${s}`));
  });

  const relatedCourses = Array.from(new Set(topics.map((x) => x.topic.course)));

  const extraTips = [];
  if (hasNumber) extraTips.push('题目中含具体数值，建议先统一单位、再代入，避免中途四舍五入。');
  if (hasFormula) extraTips.push('题目已给出符号表达式，注意区分已知量与未知量，不要中途更换字母含义。');
  if (isLong) extraTips.push('题干较长，建议先用自己的话把它压缩成两三行，再动笔。');
  if (topics.length === 0) extraTips.push('暂时没识别出明确的知识点，可以补充题目所属课程或更完整的题干，解析会更准。');

  return {
    kind: 'solve',
    qtype: type,
    qtypeMatched: matched,
    topics,
    steps,
    knowledge,
    pitfalls,
    relatedCourses,
    extraTips,
    charCount: raw.length
  };
}

/* ---------------------------------------------------------
   6. AI 模块 · 知识点提炼
   --------------------------------------------------------- */
const STOPWORDS = new Set([
  '的', '了', '是', '在', '和', '与', '或', '有', '我们', '可以', '这个', '一个',
  '这些', '那些', '因为', '所以', '如果', '就是', '这样', '那样', '不是', '什么',
  '为了', '对于', '关于', '其中', '由于', '因此', '需要', '进行', '使用', '具有',
  '能够', '表示', '得到', '使得', '以及', '但是', '而且', '并且', '然而', '同时',
  '主要', '重要', '一般', '通常', '可能', '应该', '必须', '通过', '根据', '按照',
  '包括', '分为', '可分为', '例如', '比如', '如下', '上述', '等等', '一种', '一些',
  '时候', '问题', '方法', '方式', '情况', '内容', '部分', '方面', '过程', '结果',
  '其中', '之一', '之间', '之后', '之前', '最后', '首先', '其次', '另外', '此外',
  '那么', '这里', '那里', '它', '他', '她', '我', '你', '们', '之', '其', '此',
  '则', '即', '会', '能', '要', '把', '被', '让', '使', '对', '从', '到', '向', '等',
  '本章', '本节', '本文', '本书', '本例', '本题'
]);

/* 出现在词首或词尾时说明这个 n-gram 很可能是切碎的片段 */
const WEAK_EDGE = new Set([
  '的', '了', '是', '在', '和', '与', '或', '有', '这', '那', '们', '就', '也', '还',
  '而', '但', '并', '被', '把', '让', '使', '对', '从', '到', '向', '等', '很', '更',
  '最', '会', '能', '要', '可', '之', '其', '此', '所', '及', '则', '即', '如', '因',
  '由', '于', '个', '种', '些', '以', '为', '上', '下', '中', '内', '外', '里'
]);

/* 出现在词中间时几乎可以断定不是术语 */
const WEAK_INNER = new Set([
  '的', '了', '是', '和', '与', '或', '在', '就', '也', '还', '而', '但', '并', '被',
  '把', '让', '使', '从', '到', '向', '很', '更', '最', '等', '即', '则', '此', '其', '所'
]);

/* 少量确实含虚词、但属于学科术语的词，豁免上面的过滤 */
const TERM_WHITELIST = new Set(['求和', '求和公式', '和函数', '调和', '内积和']);

function isWeakTerm(w) {
  if (TERM_WHITELIST.has(w)) return false;
  if (w.length < 2) return true;
  if (STOPWORDS.has(w)) return true;
  if (WEAK_EDGE.has(w[0]) || WEAK_EDGE.has(w[w.length - 1])) return true;
  for (let i = 1; i < w.length - 1; i++) {
    if (WEAK_INNER.has(w[i])) return true;
  }
  return false;
}

function splitSentences(text) {
  return String(text || '')
    .split(/[。！？；!?;\n\r]+/)
    .map((s) => s.trim())
    .filter((s) => s.length >= 6);
}

function tokenize(text) {
  // 抽取 2~4 字的中文候选词与英文/数字串
  const out = [];
  const clean = String(text || '').replace(/[^\u4e00-\u9fa5A-Za-z0-9]/g, ' ');
  const cnChunks = clean.match(/[\u4e00-\u9fa5]+/g) || [];
  cnChunks.forEach((chunk) => {
    for (let n = 6; n >= 2; n--) {
      for (let i = 0; i + n <= chunk.length; i++) {
        const w = chunk.slice(i, i + n);
        if (isWeakTerm(w)) continue;
        out.push(w);
      }
    }
  });
  const enChunks = clean.match(/[A-Za-z][A-Za-z0-9+#.\-]{1,}/g) || [];
  enChunks.forEach((w) => {
    if (w.length >= 2) out.push(w.toLowerCase());
  });
  return out;
}

function termFrequency(text) {
  const tokens = tokenize(text);
  const freq = new Map();
  tokens.forEach((w) => freq.set(w, (freq.get(w) || 0) + 1));
  return freq;
}

/** 从词频里挑出有代表性的术语：频次权重高、长度适中、且不互为片段 */
function topTerms(freq, limit = 12, minCount = 1) {
  const all = Array.from(freq.entries()).filter(([w]) => !isWeakTerm(w));

  // 若重复出现过的词足够多，就只保留它们（单次出现的多是切碎片段）
  const repeated = all.filter(([, c]) => c >= 2);
  const effMin = repeated.length >= 5 ? Math.max(minCount, 2) : minCount;

  const items = all
    .filter(([, c]) => c >= effMin)
    .map(([w, c]) => ({
      word: w,
      count: c,
      // 频次是主导因素，长度做温和加权，避免长片段压过真正的高频词
      score: Math.pow(c, 1.7) * (1 + w.length * 0.16)
    }))
    .sort((a, b) => b.score - a.score);

  // 按长度分桶，用于「单字扩展」检验
  const buckets = new Map();
  freq.forEach((c, w) => {
    if (!buckets.has(w.length)) buckets.set(w.length, []);
    buckets.get(w.length).push(w);
  });

  /** w 左右各补一个字后若频次接近，说明 w 只是更长的词的片段 */
  function isFragment(w, count) {
    const longer = buckets.get(w.length + 1) || [];
    return longer.some((e) => {
      if (!(e.startsWith(w) || e.endsWith(w))) return false;
      return (freq.get(e) || 0) >= count * 0.8;
    });
  }

  const picked = [];
  items.forEach((it) => {
    if (picked.length >= limit) return;
    // 与已选词互为子串的候选直接丢弃，避免「二叉树 / 叉树」这类重复
    if (picked.some((p) => p.word.includes(it.word) || it.word.includes(p.word))) return;
    if (isFragment(it.word, it.count)) return;
    picked.push(it);
  });

  // 极端情况下过滤太狠，回退到只做去重的结果
  if (picked.length === 0 && items.length) {
    return items.slice(0, Math.min(limit, items.length));
  }
  return picked;
}

/* 规则顺序即优先级：定义 > 性质 > 分类 > 方法
   （「二叉树的性质包括…」同时含「性质」「包括」，应判为性质而非分类） */
const KP_RULES = [
  { type: 'def', label: '定义', re: /(是指|指的是|称为|叫做|定义为|是一种|即为|又称|所谓)/ },
  { type: 'prop', label: '性质', re: /(性质|特点是|特征是|满足|恒等于|不变|条件是|充要条件|必要|充分)/ },
  { type: 'cls', label: '分类', re: /(分为|可分为|包括|包含|有以下|类型|种类|组成|划分为|三大类|两类)/ },
  { type: 'met', label: '方法', re: /(方法|步骤|算法|流程|通过|采用|利用|可以|求解|计算方式|策略)/ }
];

function classifySentence(s) {
  for (let i = 0; i < KP_RULES.length; i++) {
    if (KP_RULES[i].re.test(s)) return KP_RULES[i];
  }
  return { type: 'con', label: '结论', re: null };
}

/**
 * 知识点提炼
 */
function extractKnowledge(text) {
  const raw = String(text || '').trim();
  if (!raw) return null;

  const sentences = splitSentences(raw);
  const freq = termFrequency(raw);
  const baseTerms = topTerms(freq, 15, 1);

  // 句子打分
  const scored = sentences.map((s, idx) => {
    const rule = classifySentence(s);
    let score = 0;
    if (rule.type !== 'con') score += 3;

    const len = s.length;
    if (len >= 12 && len <= 70) score += 1.5;
    else if (len > 70) score += 0.4;

    // 术语密度
    let hitWords = [];
    baseTerms.forEach((t) => {
      if (s.includes(t.word)) { score += 0.55 * Math.min(t.count, 3); hitWords.push(t.word); }
    });

    if (/[\d=]/.test(s)) score += 0.5;
    if (idx === 0) score += 0.6;                 // 首句常是总起
    if (idx === sentences.length - 1) score += 0.3;

    return { text: s, label: rule.label, type: rule.type, score, hitWords, idx };
  }).sort((a, b) => b.score - a.score);

  const knowledge = scored.filter((s) => s.score > 0.8).slice(0, 8);

  // 术语：文本较长时只保留重复出现过的词，减少噪声
  const minCount = freq.size > 25 ? 2 : 1;
  const terms = topTerms(freq, 16, minCount);

  return {
    kind: 'extract',
    knowledgeCount: knowledge.length,
    sentenceCount: sentences.length,
    knowledge,
    terms,
    charCount: raw.length
  };
}

/* ---------------------------------------------------------
   7. AI 模块 · 资料智能总结
   --------------------------------------------------------- */
const SUMMARY_MARKERS = ['总之', '综上', '因此', '所以', '核心', '关键', '主要', '总结', '概而言之', '由此可见', '重点', '结论是'];

function summarizeText(text) {
  const raw = String(text || '').trim();
  if (!raw) return null;

  const sentences = splitSentences(raw);
  if (sentences.length <= 3) {
    return {
      kind: 'summary',
      tooShort: true,
      sentenceCount: sentences.length,
      summary: raw,
      points: sentences,
      keywords: topTerms(termFrequency(raw), 8, 1),
      compression: 1,
      charCount: raw.length
    };
  }

  const freq = termFrequency(raw);
  const maxFreq = Math.max(...Array.from(freq.values()), 1);

  const scored = sentences.map((s, idx) => {
    let score = 0;

    // 关键词权重（TF 归一化）
    const words = tokenize(s);
    const uniq = Array.from(new Set(words));
    uniq.forEach((w) => {
      const f = freq.get(w) || 0;
      if (f > 1 || w.length >= 3) {
        score += (f / maxFreq) * (1 + w.length * 0.14);
      }
    });
    score = score / Math.max(1, Math.sqrt(s.length / 30));   // 长句做惩罚

    // 位置权重
    const pos = idx / sentences.length;
    if (pos < 0.2) score += 1.6;
    else if (pos < 0.5) score += 0.6;
    if (idx === sentences.length - 1) score += 0.8;
    else if (pos > 0.85) score += 0.4;

    // 总结性标志词
    SUMMARY_MARKERS.forEach((m) => { if (s.includes(m)) score += 1.2; });

    // 长度适中的句子更可能是要点
    if (s.length >= 14 && s.length <= 80) score += 0.9;

    return { text: s, score, idx };
  });

  const want = Math.max(2, Math.min(6, Math.round(sentences.length * 0.35), sentences.length));
  const picked = scored.slice().sort((a, b) => b.score - a.score).slice(0, want);
  const ordered = picked.slice().sort((a, b) => a.idx - b.idx);

  const summaryText = ordered.map((s) => s.text).join('。') + '。';

  // 要点：按分数排序，做轻微精简提示
  const points = picked.slice()
    .sort((a, b) => b.score - a.score)
    .slice(0, 5)
    .map((s) => s.text);

  const compression = raw.length ? (summaryText.length / raw.length) : 1;

  return {
    kind: 'summary',
    tooShort: false,
    sentenceCount: sentences.length,
    pickedCount: picked.length,
    summary: summaryText,
    points,
    keywords: topTerms(freq, 10, freq.size > 25 ? 2 : 1),
    compression,
    charCount: raw.length,
    summaryChars: summaryText.length
  };
}

  global.StudyAI = {
    solveProblem,
    extractKnowledge,
    summarizeText,
    detectType,
    matchTopics,
    topTerms
  };
})(window);
